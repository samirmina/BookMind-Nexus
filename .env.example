# BookMind Nexus - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
# Port for the application (default: 8083)
SERVER_PORT=8083

# AI Gateway Configuration
# Port for the AI Gateway (default: 8081)
AI_GATEWAY_PORT=8081

# Database Configuration (PostgreSQL)
# Create a fresh database named 'BookMind_Nexus' before running the app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AI Configuration (Ollama local)
# Ollama must be running locally with the llama3.2:3b model pulled
AI_BASE_URL=http://localhost:11434/api/generate
AI_MODEL=llama3.2:3b
AI_API_KEY=
AI_TIMEOUT_SECONDS=86400

# Notion OAuth Configuration
# Get these from https://www.notion.so/my-integrations
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:8083/oauth2/callback/notion

# Google OAuth Configuration
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8083/oauth2/callback/google

# Encryption Key for OAuth Tokens and API Keys
# Generate with: CryptoUtils.generateKey() or use: openssl rand -base64 32
# Must be 32 bytes (256 bits) when base64-decoded
APP_CRYPTO_ENCRYPTION_KEY=

# Pix2Text Configuration
PIX2TEXT_URL=http://pix2text:8080
PIX2TEXT_TIMEOUT=86400s

# AI Gateway Provider Keys (optional, for cloud providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
