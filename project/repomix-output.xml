package com.bookassistant.service.file;

import com.bookassistant.util.LoggingUtils;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;

import java.io.ByteArrayOutputStream;
import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.net.URLEncoder;
import java.nio.charset.StandardCharsets;

/**
 * Calls the Marker extraction microservice to extract PDF text with
 * LaTeX math notation.
 *
 * <p><b>Where:</b> Used by {@link FileParserService} when extraction mode
 * is set to {@code marker}.</p>
 */
@Service
public class MarkerExtractionClient {

    private static final Logger log = LoggerFactory.getLogger(MarkerExtractionClient.class);

    private final String baseUrl;
    private final int timeoutSeconds;

    public MarkerExtractionClient(
            @Value("${app.extraction.marker.url:http://localhost:8080}") String baseUrl,
            @Value("${app.extraction.marker.timeout:7200s}") java.time.Duration timeout) {
        this.baseUrl = baseUrl;
        this.timeoutSeconds = (int) timeout.getSeconds();
        log.info("MarkerExtractionClient initialized | baseUrl={} | timeout={}", baseUrl, timeout);
    }

    /**
     * Extracts text from a PDF byte array via the Marker service.
     *
     * @param pdfBytes raw PDF content
     * @param fileName the original file name
     * @param startPage 1-based start page (inclusive), or 0 for all pages
     * @param endPage   1-based end page (inclusive), or 0 for all pages
     * @return list of page texts with their original page numbers from Marker
     * @throws IllegalStateException if Marker service returns non-200 or request fails
     */
    public java.util.List<PageInfo> extractPages(byte[] pdfBytes, String fileName, int startPage, int endPage) {
        if (pdfBytes == null || pdfBytes.length == 0) {
            log.warn("extractPages called with empty PDF bytes");
            return java.util.List.of();
        }

        HttpURLConnection connection = null;
        try {
            String url = baseUrl + "/extract/pdf";
            if (startPage > 0 && endPage > 0) {
                url += "?start_page=" + startPage + "&end_page=" + endPage;
            }
            String boundary = "marker-boundary-" + System.currentTimeMillis();
            String safeFileName = (fileName == null || fileName.isBlank()) ? "upload.pdf" : fileName;

            String LINE_FEED = "\r\n";
            String charset = "UTF-8";

            ByteArrayOutputStream baos = new ByteArrayOutputStream();
            OutputStream outputStream = new java.io.BufferedOutputStream(baos);

            outputStream.write(("--" + boundary + LINE_FEED).getBytes(charset));
            outputStream.write(("Content-Disposition: form-data; name=\"file\"; filename=\"" + safeFileName + "\"" + LINE_FEED).getBytes(charset));
            outputStream.write(("Content-Type: application/pdf" + LINE_FEED).getBytes(charset));
            outputStream.write(LINE_FEED.getBytes(charset));
            outputStream.write(pdfBytes);
            outputStream.write(LINE_FEED.getBytes(charset));
            outputStream.write(("--" + boundary + "--" + LINE_FEED).getBytes(charset));
            outputStream.flush();

            byte[] body = baos.toByteArray();

            connection = (HttpURLConnection) new URL(url).openConnection();
            connection.setConnectTimeout(10_000);
            connection.setReadTimeout(timeoutSeconds * 1000);
            connection.setRequestMethod("POST");
            connection.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
            connection.setRequestProperty("Content-Length", String.valueOf(body.length));
            connection.setDoOutput(true);

            try (OutputStream requestStream = connection.getOutputStream()) {
                requestStream.write(body);
                requestStream.flush();
            }

            int status = connection.getResponseCode();
            String bodyResponse;
            if (status >= 400) {
                bodyResponse = new String(connection.getErrorStream().readAllBytes(), StandardCharsets.UTF_8);
            } else {
                bodyResponse = new String(connection.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
            }

            if (status != 200) {
                throw new IllegalStateException("Marker service error | status=" + status + " | body=" + bodyResponse);
            }

            java.util.List<PageInfo> pages = extractPagesFromJson(bodyResponse);
            log.info("Marker extraction complete | pages={} | range={}-{}", pages.size(), startPage, endPage);
            return pages;

        } catch (Exception e) {
            throw new IllegalStateException("Failed to extract PDF via Marker service", e);
        } finally {
            if (connection != null) {
                connection.disconnect();
            }
        }
    }

    /**
     * Extracts text from a PDF byte array via the Marker service (all pages).
     *
     * @param pdfBytes raw PDF content
     * @return list of page texts with their original page numbers from Marker
     * @throws IllegalStateException if Marker service returns non-200 or request fails
     * @deprecated Use {@link #extractPages(byte[], String, int, int)} instead
     */
    @Deprecated
    public java.util.List<PageInfo> extractPages(byte[] pdfBytes, String fileName) {
        return extractPages(pdfBytes, fileName, 0, 0);
    }

    /**
     * Holds a single extracted page with its original page number from Marker.
     */
    public static class PageInfo {
        public final int pageNumber;
        public final String text;

        public PageInfo(int pageNumber, String text) {
            this.pageNumber = pageNumber;
            this.text = text;
        }
    }

    /**
     * Health check for the Marker service.
     *
     * @return true if the service is reachable
     */
    public boolean isHealthy() {
        try {
            String url = baseUrl + "/health";
            HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
            connection.setConnectTimeout(5000);
            connection.setReadTimeout(5000);
            connection.setRequestMethod("GET");

            int status = connection.getResponseCode();
            String body = new String(connection.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
            connection.disconnect();
            return status == 200 && body.contains("ok");
        } catch (Exception e) {
            log.warn("Marker service health check failed: {}", e.getMessage());
            return false;
        }
    }

    /**
     * Simple JSON parser to extract page numbers and text from Marker response chunks.
     * Avoids adding Jackson or other JSON libraries.
     */
    private java.util.List<PageInfo> extractPagesFromJson(String json) {
        java.util.List<PageInfo> pages = new java.util.ArrayList<>();

        // Look for "chunks":[{"page":1,"text":"..."},...]
        int chunksIdx = json.indexOf("\"chunks\"");
        if (chunksIdx < 0) {
            return pages;
        }

        int arrayStart = json.indexOf('[', chunksIdx);
        if (arrayStart < 0) {
            return pages;
        }

        // Find all chunk objects: {"page":N,"text":"..."}
        int searchFrom = arrayStart;
        while (true) {
            int pageIdx = json.indexOf("\"page\":", searchFrom);
            if (pageIdx < 0) break;

            // Extract page number
            int pageValueStart = json.indexOf(':', pageIdx) + 1;
            while (pageValueStart < json.length() && Character.isWhitespace(json.charAt(pageValueStart))) {
                pageValueStart++;
            }
            int pageNumber = -1;
            if (pageValueStart < json.length() && Character.isDigit(json.charAt(pageValueStart))) {
                pageNumber = Integer.parseInt(json.substring(pageValueStart, json.indexOf(',', pageValueStart)).trim());
            }

            // Find the corresponding "text":"..." field
            int textIdx = json.indexOf("\"text\":", pageIdx);
            if (textIdx < 0) break;

            int valueStart = json.indexOf(':', textIdx) + 1;
            while (valueStart < json.length() && Character.isWhitespace(json.charAt(valueStart))) {
                valueStart++;
            }

            if (valueStart >= json.length() || json.charAt(valueStart) != '"') {
                searchFrom = textIdx + 1;
                continue;
            }

            valueStart++; // skip opening quote
            StringBuilder sb = new StringBuilder();
            while (valueStart < json.length()) {
                char c = json.charAt(valueStart);
                if (c == '"' && valueStart > 0 && json.charAt(valueStart - 1) != '\\') {
                    break;
                }
                sb.append(c);
                valueStart++;
            }

            String text = sb.toString()
                    .replace("\\n", "\n")
                    .replace("\\t", "\t")
                    .replace("\\\"", "\"")
                    .replace("\\\\", "\\");

            if (!text.isBlank()) {
                pages.add(new PageInfo(pageNumber > 0 ? pageNumber : pages.size() + 1, text));
            }

            searchFrom = valueStart + 1;
        }

        return pages;
    }
}
