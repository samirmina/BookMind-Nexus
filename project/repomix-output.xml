                    <option value="de-AT" th:text="#{lang.de-AT}"></option>
                    <option value="it" th:text="#{lang.it}"></option>
                    <option value="nl" th:text="#{lang.nl}"></option>
                    <option value="pt" th:text="#{lang.pt}"></option>
                    <option value="ru" th:text="#{lang.ru}"></option>
                    <option value="uk" th:text="#{lang.uk}"></option>
                    <option value="af" th:text="#{lang.af}"></option>
                    <option value="zh" th:text="#{lang.zh}"></option>
                    <option value="ja" th:text="#{lang.ja}"></option>
                </select>
            </div>
        </div>
    </nav>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <span class="logo-icon">🧠</span>
                <h1 th:text="#{home.brand}"></h1>
            </div>
            <h2 class="text-center mb-3" th:text="#{contact.title}"></h2>
            <p class="text-muted text-center mb-4" style="font-size:0.9rem;" th:text="#{contact.description}"></p>

    <div class="alert alert-error" id="errorAlert" style="display:none;">⚠️ <span th:text="#{contact.error}"></span></div>
    <div class="alert alert-success" id="successAlert" style="display:none;">✅ <span th:text="#{contact.success}"></span></div>

    <form th:action="@{/contact}" method="post">
                <div class="form-group">
                    <label th:text="#{contact.name}"></label>
                    <input type="text" name="name" th:placeholder="#{contact.namePlaceholder}" required autofocus>
                </div>
                <div class="form-group">
                    <label th:text="#{contact.email}"></label>
                    <input type="email" name="email" th:placeholder="#{contact.emailPlaceholder}" required>
                </div>
                <div class="form-group">
                    <label th:text="#{contact.message}"></label>
                    <textarea name="message" th:placeholder="#{contact.messagePlaceholder}" required></textarea>
                </div>
                <button type="submit" class="btn-auth" th:text="#{contact.submit}"></button>
            </form>

            <div class="auth-footer">
                <a href="/" th:text="#{contact.home}"></a> · <a href="/app" th:text="#{contact.app}"></a>
            </div>
        </div>
    </div>
    <script src="/js/ui-audit.js" defer></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/home.html">
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns:th="http://www.thymeleaf.org"
      th:lang="${langAttr}" th:dir="${dirAttr}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="#{home.title}"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent: #7c3aed;
            --accent-light: #a78bfa;
            --bg: #0f0a1e;
            --bg-card: #1a1a2e;
            --text: #f9fafb;
            --text-muted: #9ca3af;
            --border: #2d2d44;
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
        }
        a { text-decoration: none; color: inherit; }
        
        /* Navbar */
        .navbar {
            background: rgba(15, 10, 30, 0.95);
            border-bottom: 1px solid var(--border);
            padding: 1rem 0;
            position: sticky; top: 0; z-index: 1000;
            backdrop-filter: blur(10px);
        }
        .navbar-inner {
            max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;
            display: flex; align-items: center; justify-content: space-between;
        }
        .brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1.2rem; }
        .brand-icon { font-size: 1.5rem; }
        .nav-links { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
        .nav-links a { color: var(--text-muted); font-size: 0.9rem; transition: all 0.2s; padding: 0.4rem 0.9rem; border-radius: 0.5rem; }
        .nav-links a:hover { color: var(--text); background: rgba(255,255,255,0.05); }
        .nav-link { border: 1px solid transparent; }
        .nav-link:hover { border-color: var(--border); }
        .nav-cta {
            background: var(--accent); color: #fff !important;
            padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-weight: 600;
            transition: all 0.2s;
        }
        .nav-cta:hover { background: var(--accent-light); color: #fff !important; }
        .nav-cta-secondary {
            border: 1px solid var(--accent); color: var(--accent-light) !important;
            padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-weight: 600; margin-left: 0.5rem;
        }
        .nav-cta-secondary:hover { background: rgba(124,58,237,0.1); color: #fff !important; }
        .lang-switch { font-size: 0.8rem; height: 32px; }
        
        /* Hero */
        .hero {
            text-align: center; padding: 7rem 1.5rem 5rem;
            background: linear-gradient(135deg, rgba(124,58,237,0.08), rgba(15,10,30,1));
            border-bottom: 1px solid var(--border);
        }
        .hero-title {
            font-size: 3.5rem; font-weight: 700; margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--accent), var(--accent-light));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-ar { font-size: 1.6rem; margin-bottom: 0.5rem; }
        .hero-en { font-size: 1.15rem; color: var(--text-muted); margin-bottom: 2rem; }
        .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
        .btn-primary-hero {
            background: linear-gradient(135deg, var(--accent), var(--accent-light));
            color: #fff; padding: 0.9rem 2.5rem; border-radius: 0.75rem;
            font-weight: 700; font-size: 1.05rem; border: none; cursor: pointer;
            transition: all 0.2s; box-shadow: 0 4px 20px rgba(124,58,237,0.3);
        }
        .btn-primary-hero:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(124,58,237,0.4); color: #fff; }
        .btn-secondary-hero {
            border: 1px solid var(--accent); color: var(--accent-light);
            padding: 0.9rem 2.5rem; border-radius: 0.75rem;
            font-weight: 700; font-size: 1.05rem; background: transparent; cursor: pointer;
            transition: all 0.2s;
        }
        .btn-secondary-hero:hover { background: rgba(124,58,237,0.1); color: #fff; }
        
        /* Features */
        .section { padding: 5rem 1.5rem; }
        .section-inner { max-width: 1100px; margin: 0 auto; }
        .section-title { text-align: center; font-size: 2rem; font-weight: 700; margin-bottom: 3rem; }
        .features-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }
        .feature-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 1rem; padding: 2rem; text-align: center;
            transition: all 0.2s;
        }
        .feature-card:hover { border-color: var(--accent); transform: translateY(-4px); }
        .feature-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
        .feature-card h3 { font-size: 1.15rem; margin-bottom: 0.75rem; }
        .feature-card p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.7; }
        
        /* Steps */
        .steps-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem; margin-top: 2rem;
        }
        .step { text-align: center; }
        .step-num {
            display: inline-flex; align-items: center; justify-content: center;
            width: 50px; height: 50px; background: linear-gradient(135deg, var(--accent), var(--accent-light));
            color: #fff; border-radius: 50%; font-size: 1.3rem; font-weight: 700; margin-bottom: 1rem;
        }
        .step h4 { font-size: 1.1rem; margin-bottom: 0.5rem; }
        .step p { color: var(--text-muted); font-size: 0.9rem; }
        
        /* Footer */
        footer {
            text-align: center; padding: 2.5rem 1.5rem;
            border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.85rem;
        }
        footer a { color: var(--accent-light); }
        footer a:hover { color: var(--text); }
        
        @media (max-width: 768px) {
            .hero-title { font-size: 2.2rem; }
            .nav-links { gap: 1rem; }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="brand">
                <span class="brand-icon">🧠</span>
                <span th:text="#{home.brand}"></span>
            </a>
            <div class="nav-links">
                <a href="#features" class="nav-link" th:text="#{home.features}"></a>
                <a href="#how-it-works" class="nav-link" th:text="#{home.howItWorks}"></a>
                <a href="/contact" class="nav-link" th:text="#{home.contact}"></a>
                <a th:if="${session.userId == null}" href="/login" class="nav-cta" th:text="#{navbar.login}"></a>
                <a th:if="${session.userId == null}" href="/register" class="nav-cta-secondary" th:text="#{register.title}"></a>
                <a th:if="${session.userId != null}" href="/app" class="nav-cta" th:text="#{navbar.app}"></a>
                <a th:if="${session.userId != null}" href="/outputs" class="nav-cta-secondary">📋 <span th:text="#{navbar.outputs}"></span></a>
                <form th:if="${session.userId != null}" th:action="@{/logout}" method="post" class="d-inline">
                    <button class="nav-cta-secondary" type="submit" th:text="#{navbar.logout}"></button>
                </form>
                <select class="form-select form-select-sm lang-switch" style="width:auto;background:#1a1a2e;color:#e2e8f0;border:1px solid #2d2d44;" onchange="if(this.value)window.location.href='/language/switch?lang='+this.value+'&redirect=/'">
                        <option value="" th:text="#{navbar.language}"></option>
                        <option value="ar" th:text="#{lang.ar}"></option>
                        <option value="en" th:text="#{lang.en}"></option>
                        <option value="es" th:text="#{lang.es}"></option>
                        <option value="es-MX" th:text="#{lang.es-MX}"></option>
                        <option value="fr" th:text="#{lang.fr}"></option>
                        <option value="de" th:text="#{lang.de}"></option>
                        <option value="de-AT" th:text="#{lang.de-AT}"></option>
                        <option value="it" th:text="#{lang.it}"></option>
                        <option value="nl" th:text="#{lang.nl}"></option>
                        <option value="pt" th:text="#{lang.pt}"></option>
                        <option value="ru" th:text="#{lang.ru}"></option>
                        <option value="uk" th:text="#{lang.uk}"></option>
                        <option value="af" th:text="#{lang.af}"></option>
                        <option value="zh" th:text="#{lang.zh}"></option>
                        <option value="ja" th:text="#{lang.ja}"></option>
                </select>
            </div>
        </div>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-ar" th:if="${uiLanguage == 'ar'}" th:text="#{home.hero.ar}"></div>
        <div class="hero-en" th:if="${uiLanguage != 'ar'}" th:text="#{home.hero.en}"></div>
        <h1 class="hero-title" th:text="#{home.hero.title}"></h1>
        <div class="hero-actions">
            <a th:if="${session.userId == null}" href="/login" class="btn-primary-hero" th:text="#{home.hero.cta}"></a>
            <a th:if="${session.userId != null}" href="/app" class="btn-primary-hero" th:text="#{home.hero.cta}"></a>
            <a href="#how-it-works" class="btn-secondary-hero" th:text="#{home.hero.learnMore}"></a>
        </div>
    </section>

    <!-- Features -->
    <section class="section" id="features">
        <div class="section-inner">
            <h2 class="section-title" th:text="#{home.features.title}"></h2>
            <div class="features-grid">
                <div class="feature-card">
                    <span class="feature-icon">💬</span>
                    <h3 th:text="#{home.features.ask}"></h3>
                    <p th:text="#{home.features.ask.desc}"></p>
                </div>
                <div class="feature-card">
                    <span class="feature-icon">📊</span>
                    <h3 th:text="#{home.features.insights}"></h3>
                    <p th:text="#{home.features.insights.desc}"></p>
                </div>
                <div class="feature-card">
                    <span class="feature-icon">🧪</span>
                    <h3 th:text="#{home.features.lab}"></h3>
                    <p th:text="#{home.features.lab.desc}"></p>
                </div>
                <div class="feature-card">
                    <span class="feature-icon">🔗</span>
                    <h3 th:text="#{home.features.sync}"></h3>
                    <p th:text="#{home.features.sync.desc}"></p>
                </div>
                <div class="feature-card">
                    <span class="feature-icon">🧩</span>
                    <h3 th:text="#{home.features.images}"></h3>
                    <p th:text="#{home.features.images.desc}"></p>
                </div>
                <div class="feature-card">
                    <span class="feature-icon">🌐</span>
                    <h3 th:text="#{home.features.bilingual}"></h3>
                    <p th:text="#{home.features.bilingual.desc}"></p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="section" id="how-it-works" style="background: var(--bg-card); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
        <div class="section-inner">
            <h2 class="section-title" th:text="#{home.howItWorks.title}"></h2>
            <div class="steps-grid">
                <div class="step">
                    <div class="step-num">1</div>
                    <h4 th:text="#{home.step1.title}"></h4>
                    <p th:text="#{home.step1.desc}"></p>
                </div>
                <div class="step">
                    <div class="step-num">2</div>
                    <h4 th:text="#{home.step2.title}"></h4>
                    <p th:text="#{home.step2.desc}"></p>
                </div>
                <div class="step">
                    <div class="step-num">3</div>
                    <h4 th:text="#{home.step3.title}"></h4>
                    <p th:text="#{home.step3.desc}"></p>
                </div>
                <div class="step">
                    <div class="step-num">4</div>
                    <h4 th:text="#{home.step4.title}"></h4>
                    <p th:text="#{home.step4.desc}"></p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <p class="mb-1">🧠 <span th:text="#{home.brand}"></span> — <span th:text="#{about.description}"></span></p>
        <p class="mb-1">
            <a href="/contact" th:text="#{home.contact}"></a> · 
            <a href="/about" th:text="#{about.title}"></a> · 
            <a th:if="${session.userId == null}" href="/login" th:text="#{navbar.login}"></a> · 
            <a th:if="${session.userId == null}" href="/register" th:text="#{register.title}"></a> · 
                <a th:if="${session.userId != null}" href="/app" th:text="#{navbar.app}"></a> · 
                <a th:if="${session.userId != null}" href="/outputs" th:text="#{navbar.outputs}"></a> · 
                <form th:if="${session.userId != null}" th:action="@{/logout}" method="post" class="d-inline" style="display:inline;">
                    <button type="submit" style="background:none;border:none;color:#a78bfa;cursor:pointer;padding:0;" th:text="#{navbar.logout}"></button>
                </form>
        </p>
    </footer>
    <script src="/js/ui-audit.js" defer></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/index.html">
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns:th="http://www.thymeleaf.org"
      th:lang="${langAttr}" th:dir="${dirAttr}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="#{app.title}"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/styles.css}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css">
    <style>
        :root {
            --accent-primary: #7c3aed;
            --accent-secondary: #a78bfa;
            --accent-glow: rgba(124, 58, 237, 0.3);
        }
        body {
            font-family: 'Cairo', 'Inter', sans-serif;
            background: #0f0a1e;
            color: #e2e8f0;
            min-height: 100vh;
        }
        .navbar-brand { font-weight: 700; font-size: 1.3rem; }
        .navbar-brand .logo-icon { font-size: 1.5rem; }
        .nav-pills .nav-link {
            color: #94a3b8;
            border-radius: 0.5rem;
            padding: 0.35rem 0.75rem;
            margin: 0;
            font-size: 0.9rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .nav-pills .nav-link:hover { color: #e2e8f0; background: #1e1b4b; }
        .nav-pills .nav-link.active {
            color: #fff;
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            box-shadow: 0 2px 10px var(--accent-glow);
        }
        .navbar .d-flex.align-items-center {
            align-items: center;
            gap: 0.5rem;
        }
        .navbar .btn-outline-nova,
        .navbar .btn-nova,
        .nav-cta-secondary {
            padding: 0.35rem 0.75rem;
            font-size: 0.85rem;
            border-radius: 0.5rem;
            line-height: 1.4;
        }
        .navbar .lang-switch {
            padding: 0.35rem 0.5rem;
            font-size: 0.85rem;
            border-radius: 0.5rem;
            line-height: 1.4;
        }
        .section-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: border-color 0.2s;
        }
        .section-card:hover { border-color: #4c1d95; }
        .section-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #e2e8f0;
        }
        .form-control, .form-select {
            background: #0f0a1e;
            border: 1px solid #2d2d44;
            color: #e2e8f0;
            border-radius: 0.5rem;
        }
        .form-control:focus, .form-select:focus {
            background: #0f0a1e;
            border-color: var(--accent-primary);
            color: #e2e8f0;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }
        .page-range-input {
            min-width: 80px;
            max-width: 100px;
            background: #2a2a40;
            border: 1px solid #4a4a6a;
            color: #ffffff;
            border-radius: 0.5rem;
            padding: 0.35rem 0.5rem;
            font-size: 0.9rem;
            text-align: center;
        }
        .page-range-input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px var(--accent-glow);
            outline: none;
        }
        .page-range-input::placeholder {
            color: #64748b;
            opacity: 1;
        }
        .page-range-container {
            background: #1a1a2e;
            border: 1px solid #4a4a6a;
            border-radius: 0.75rem;
            padding: 1rem;
            margin-bottom: 1rem;
            width: 100%;
            flex: 1 0 100%;
            max-width: 100%;
        }
        .btn-nova {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #fff;
            border: none;
            border-radius: 0.5rem;
            padding: 0.6rem 1.2rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-nova:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px var(--accent-glow);
            color: #fff;
        }
        .btn-outline-nova {
            border: 1px solid var(--accent-primary);
            color: var(--accent-secondary);
            border-radius: 0.5rem;
            background: transparent;
        }
        .btn-outline-nova:hover {
            background: var(--accent-primary);
            color: #fff;
        }
        .section-card {
            position: relative;
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        @keyframes text-light-shift {
            0%, 100% {
                text-shadow:
                    2px 2px 4px rgba(0, 0, 0, 0.9),
                    0 0 12px rgba(255, 100, 50, 0.25);
            }
            33% {
                text-shadow:
                    1px 3px 4px rgba(0, 0, 0, 0.85),
                    0 0 16px rgba(50, 255, 100, 0.2);
            }
            66% {
                text-shadow:
                    3px 1px 4px rgba(0, 0, 0, 0.88),
                    0 0 14px rgba(100, 100, 255, 0.3);
            }
        }
        .response-box {
            background: #0f0a1e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 1.25rem;
            margin-top: 1rem;
            min-height: 80px;
            max-height: 600px;
            overflow-y: auto;
            direction: rtl;
            text-align: right;
            line-height: 1.9;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .response-box[dir="ltr"] { direction: ltr; text-align: left; }

        .response-box > * {
            position: relative;
            z-index: 1;
            text-shadow:
                2px 2px 4px rgba(0, 0, 0, 0.9),
                0 0 10px rgba(255, 150, 100, 0.15);
            animation: text-light-shift 8s ease-in-out infinite;
        }
        .response-box pre {
            background: #1a1a2e;
            color: #e2e8f0;
            padding: 0.75rem;
            border-radius: 0.375rem;
            overflow-x: auto;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .response-box h1, .response-box h2, .response-box h3,
        .response-box h4, .response-box h5, .response-box h6 {
            color: #e2e8f0;
            margin-top: 1rem;
            margin-bottom: 0.5rem;
        }
        .response-box p {
            margin-bottom: 0.75rem;
            padding: 0 0.25rem;
        }
        .response-box ul, .response-box ol {
            padding-right: 1.5rem;
            padding-left: 0.5rem;
        }
        .response-box li {
            margin-bottom: 0.35rem;
            padding: 0 0.25rem;
        }
        .response-box blockquote {
            border-right: 4px solid #7c3aed;
            padding-right: 1rem;
            margin: 1rem 0;
            color: #cbd5e1;
        }
        .loading-overlay {
            display: none;
            text-align: center;
            padding: 1.5rem;
        }
        .loading-overlay.active { display: block; }
        .spinner {
            display: inline-block;
            width: 2rem; height: 2rem;
            border: 3px solid #2d2d44;
            border-top-color: var(--accent-primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .upload-zone {
            border: 2px dashed #4c1d95;
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
            background: rgba(124, 58, 237, 0.05);
            transition: all 0.2s;
            cursor: pointer;
        }
        .upload-zone:hover { border-color: var(--accent-secondary); background: rgba(124, 58, 237, 0.1); }
        .badge-nova {
            background: var(--accent-primary);
            color: #fff;
            font-size: 0.75rem;
            padding: 0.35rem 0.6rem;
            border-radius: 0.375rem;
        }
        .page-section { scroll-margin-top: 5rem; }
        .sticky-header {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: rgba(15, 10, 30, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #2d2d44;
        }
        .user-menu .dropdown-menu {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
        }
        .user-menu .dropdown-item { color: #e2e8f0; }
        .user-menu .dropdown-item:hover { background: #2d2d44; }
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 0.75rem;
            margin-top: 1rem;
        }
        .gallery-item { text-align: center; }
        .gallery-thumb {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 0.5rem;
            border: 1px solid #2d2d44;
        }
        .gallery-label { font-size: 0.8rem; color: #94a3b8; margin-top: 0.3rem; display: block; }
        .tab-nav { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
        @media (max-width: 768px) {
            .tab-nav { gap: 0.25rem; }
            .nav-pills .nav-link { font-size: 0.8rem; padding: 0.4rem 0.6rem; }
        }
        .collapsible-header {
            cursor: pointer;
            user-select: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.5rem 0.75rem;
            background: rgba(124, 58, 237, 0.1);
            border: 1px solid #2d2d44;
            border-radius: 0.5rem;
            color: #a78bfa;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.2s;
        }
        .collapsible-header:hover {
            background: rgba(124, 58, 237, 0.2);
            color: #fff;
        }
        .collapsible-header .toggle-icon {
            transition: transform 0.2s;
            font-size: 0.75rem;
        }
        .collapsible-header.expanded .toggle-icon {
            transform: rotate(180deg);
        }
        .collapsible-header.expanded {
            margin-bottom: 6px;
            border-radius: 0.5rem 0.5rem 0 0;
        }
        .collapsible-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out, padding 0.3s ease-out;
            padding: 0 0.5rem;
            border: 1px solid transparent;
            border-top: none;
            border-radius: 0 0 0.5rem 0.5rem;
        }
        .collapsible-content.open {
            max-height: 2000px;
            padding: 0;
            border: none;
            margin-top: 0;
            overflow: visible;
        }

        .response-section {
            margin-top: 1.5rem;
            border-radius: 1rem;
            overflow: visible;
            background: transparent;
            border: 2px solid transparent;
            box-shadow:
                0 0 25px rgba(255, 0, 0, 0.35),
                0 0 25px rgba(0, 136, 255, 0.3),
                0 0 25px rgba(136, 0, 255, 0.35);
            animation: ambient-breathe 4s ease-in-out infinite;
            position: relative;
        }

        .response-section-header {
            position: relative;
            padding: 0.75rem 1rem;
            background: transparent;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            font-weight: 600;
            color: #e2e8f0;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            z-index: 1;
        }

        .response-section-header::before {
            content: '✨';
            font-size: 1rem;
        }

        .ai-response-wrapper {
            position: relative;
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 1.5rem;
            margin-top: 0;
            isolation: isolate;
        }

        .ai-response-wrapper::before {
            content: none;
        }

        .ai-response-wrapper::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                ellipse at 90% 10%,
                rgba(255, 255, 255, 0.35) 0%,
                rgba(255, 200, 150, 0.12) 35%,
                transparent 65%
            );
            pointer-events: none;
            z-index: 1;
            mix-blend-mode: soft-light;
            animation: light-breathe 8s ease-in-out infinite;
        }

        .ai-response-wrapper > * {
            position: relative;
            z-index: 2;
        }

        .ai-response-wrapper .response-box > * {
            text-shadow:
                2px 2px 4px rgba(0, 0, 0, 0.9),
                0 0 10px rgba(255, 150, 100, 0.15);
            animation: text-light-shift 8s ease-in-out infinite;
        }

        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        @keyframes ambient-breathe {
            0%, 100% {
                box-shadow:
                    0 0 25px rgba(255, 0, 0, 0.25),
                    0 0 25px rgba(0, 136, 255, 0.2),
                    0 0 25px rgba(136, 0, 255, 0.25);
            }
            50% {
                box-shadow:
                    0 0 40px rgba(255, 0, 0, 0.15),
                    0 0 40px rgba(0, 136, 255, 0.3),
                    0 0 40px rgba(136, 0, 255, 0.15);
            }
        }

        @keyframes light-breathe {
            0%, 100% { opacity: 0.85; }
            50% { opacity: 1; }
        }

        .collapsible-section { display: block; }
    </style>
</head>
<body>
    <!-- Header / Navbar -->
    <header class="sticky-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-dark py-2">
                <a class="navbar-brand" th:href="@{/}">
                    <span class="logo-icon">🧠</span>
                    <span>BookMind Nexus</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 nav-pills">
                            <li class="nav-item"><button class="nav-link active" onclick="switchOuterTab(this, 'ask')"><span th:text="#{app.ask}"></span></button></li>
                            <li class="nav-item"><button class="nav-link" onclick="switchOuterTab(this, 'insights')"><span th:text="#{app.insights}"></span></button></li>
                            <li class="nav-item"><button class="nav-link" onclick="switchOuterTab(this, 'study')"><span th:text="#{app.lab}"></span></button></li>
                            <li class="nav-item"><button class="nav-link" onclick="switchOuterTab(this, 'sync')"><span th:text="#{app.sync}"></span></button></li>
                            <li class="nav-item"><button class="nav-link" onclick="switchOuterTab(this, 'responses')"><span>Responses</span></button></li>
                        </ul>
                    <div class="d-flex align-items-center gap-2">
                        <span th:if="${isLoggedIn}" class="text-light small">
                            <span th:text="#{navbar.welcome}"></span> <span th:text="${currentUserEmail}">user</span>
                        </span>
                        <a th:href="@{/accounts}" class="btn btn-outline-nova btn-sm" th:text="#{navbar.accounts}"></a>
                        <a th:href="@{/outputs}" class="btn btn-outline-nova btn-sm" th:text="#{navbar.outputs}"></a>
                        <form th:if="${isLoggedIn}" th:action="@{/logout}" method="post" class="d-inline">
                            <button class="nav-cta-secondary" type="submit" th:text="#{navbar.logout}"></button>
                        </form>
                        <a th:if="${!isLoggedIn}" th:href="@{/login}" class="btn btn-nova btn-sm" th:text="#{navbar.login}"></a>
                        <select class="form-select form-select-sm lang-switch" style="width:auto;background:#1a1a2e;color:#e2e8f0;border:1px solid #2d2d44;" onchange="if(this.value)window.location.href='/language/switch?lang='+this.value+'&redirect=/app'">
                            <option value="" th:text="#{navbar.language}"></option>
                            <option value="ar" th:text="#{lang.ar}"></option>
                            <option value="en" th:text="#{lang.en}"></option>
                            <option value="es" th:text="#{lang.es}"></option>
                            <option value="es-MX" th:text="#{lang.es-MX}"></option>
                            <option value="fr" th:text="#{lang.fr}"></option>
                            <option value="de" th:text="#{lang.de}"></option>
                            <option value="de-AT" th:text="#{lang.de-AT}"></option>
                            <option value="it" th:text="#{lang.it}"></option>
                            <option value="nl" th:text="#{lang.nl}"></option>
                            <option value="pt" th:text="#{lang.pt}"></option>
                            <option value="ru" th:text="#{lang.ru}"></option>
                            <option value="uk" th:text="#{lang.uk}"></option>
                            <option value="af" th:text="#{lang.af}"></option>
                            <option value="zh" th:text="#{lang.zh}"></option>
                            <option value="ja" th:text="#{lang.ja}"></option>
                        </select>
                        <select id="extractionModeSelect" class="form-select form-select-sm" style="width:auto;background:#1a1a2e;color:#e2e8f0;border:1px solid #2d2d44;" onchange="updateExtractionMode(this.value)">
                            <option value="" th:text="#{navbar.language}"></option>
                            <option value="marker">Marker</option>
                            <option value="pix2text">Pix2Text</option>
                            <option value="text-layer">PDFBox Text</option>
                        </select>
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <main class="container py-4">
        <div th:if="${success != null}" class="alert alert-success" th:text="${success}"></div>
        <div th:if="${error != null}" class="alert alert-danger" th:text="${error}"></div>

        <!-- BOOK UPLOAD -->
        <section class="section-card page-section" id="source">
            <div class="section-title"><span>📥</span> <span th:text="#{app.gallery.title}"></span></div>
            <form id="uploadForm" enctype="multipart/form-data">
                <div class="upload-zone">
                    <div class="mb-2" style="font-size:2rem;">📄</div>
                    <h5 class="mb-1" th:text="#{app.upload.title}"></h5>
                    <p class="text-muted small mb-3" th:text="#{app.upload.desc}"></p>
                    <div class="input-group mx-auto" style="max-width:500px;">
                        <input type="file" class="form-control" id="uploadFile" accept=".pdf" required>
                        <button class="btn btn-nova" type="submit" th:text="#{app.upload.submit}" id="uploadSubmitBtn"></button>
                    </div>
                    <div id="uploadProgress" class="mt-3" style="display:none;">
                        <div class="progress" style="height: 1.25rem;">
                            <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%"></div>
                        </div>
                        <div id="uploadProgressText" class="small text-muted mt-1"></div>
                    </div>
                </div>
            </form>
        </section>

        <!-- ASK -->
        <section class="section-card page-section" id="ask">
            <div class="section-title"><span>💬</span> <span th:text="#{app.ask}"></span></div>
            <form th:action="@{/qa}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('ask-loading')">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" name="question" th:placeholder="#{app.ask.placeholder}" required>
                    <button class="btn btn-nova" type="submit" th:text="#{app.ask.submit}"></button>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="ask-cross" name="crossPlatform" value="true">
                    <label class="form-check-label" for="ask-cross" th:text="#{app.ask.crossPlatform}"></label>
                </div>
            </form>
            <div th:if="${crossPlatformEnabled}" class="mt-2 p-2" style="background:#1a1a2e; border:1px solid #2d2d44; border-radius:0.5rem; font-size:0.85rem; color:#94a3b8;">
                <span th:if="${hasLinkedAccount != null && hasLinkedAccount}" style="color:#10b981;">●</span>
                <span th:if="${hasLinkedAccount == null || !hasLinkedAccount}" style="color:#ef4444;">●</span>
                <span th:if="${hasLinkedAccount != null && hasLinkedAccount}"> Notion linked</span>
                <span th:if="${hasLinkedAccount == null || !hasLinkedAccount}"> Notion not linked</span>
                <span th:if="${hasLinkedAccount != null && hasLinkedAccount && externalNotesCount > 0}"> — <span th:text="${externalNotesCount}">0</span> notes loaded</span>
                <span th:if="${hasLinkedAccount != null && hasLinkedAccount && externalNotesCount == 0}"> — no notes synced yet (use accounts page to sync)</span>
            </div>
            <div class="loading-overlay" id="ask-loading">
                <div class="spinner"></div>
                <p class="mt-2" th:text="#{app.ask.loading}"></p>
            </div>
            <div class="gallery-grid">
                <div th:each="img : ${cacheImages}" class="gallery-item">
                    <a th:href="@{'/cache/' + ${cacheBookName} + '/images/' + ${img.file}}" target="_blank">
                        <img th:src="@{'/cache/' + ${cacheBookName} + '/images/' + ${img.file}}" th:alt="'Page ' + ${img.page}" class="gallery-thumb">
                    </a>
                    <span class="gallery-label" th:text="#{app.gallery.page} + ' ' + ${img.page}"></span>
                </div>
            </div>
        </section>

        <!-- INSIGHTS -->
        <section class="section-card page-section" id="insights">
            <div class="section-title"><span>📊</span> <span th:text="#{app.insights.title}"></span></div>
            <div class="tab-nav">
                <button class="btn btn-outline-nova btn-sm active" onclick="switchTab(this, 'insight-summary')" th:text="#{app.insights.summary}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'insight-reality')" th:text="#{app.insights.realism}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'insight-concept')" th:text="#{app.insights.conceptMap}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'insight-risk')" th:text="#{app.insights.riskAlerts}"></button>
            </div>

            <div id="insight-summary" class="insight-panel">
                <div class="row g-2">
                    <div class="col-auto">
                        <form th:action="@{/summary/general}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('summary-loading')">
                            <button class="btn btn-nova btn-sm" th:text="#{app.insights.summaryGeneral}"></button>
                        </form>
                    </div>
                    <div class="col-auto">
                        <div class="page-range-container">
                            <label class="form-label small text-muted mb-1" th:text="#{app.insights.pageRange}">Target Page Range:</label>
                                <form th:action="@{/summary/pages}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('pages-loading')" class="d-flex gap-1">
                                <input type="number" class="page-range-input" name="startPage" th:placeholder="#{app.gallery.page}" required>
                                <input type="number" class="page-range-input" name="endPage" th:placeholder="#{app.gallery.of}" required>
                                <select class="form-select form-select-sm" name="chunkSize" style="background:#1a1a2e;color:#e2e8f0;border:1px solid #2d2d44;width:auto;">
                                    <option value="auto" th:text="#{app.insights.chunkAuto}">Auto</option>
                                    <option value="3">3 pages</option>
                                    <option value="5" selected>5 pages</option>
                                    <option value="10">10 pages</option>
                                    <option value="20">20 pages</option>
                                </select>
                                <button class="btn btn-outline-nova btn-sm" type="submit" th:text="#{app.insights.summaryPage}"></button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="loading-overlay" id="summary-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.summary}"></p></div>
                <div class="loading-overlay" id="pages-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.summary}"></p></div>
            </div>

            <div id="insight-reality" class="insight-panel" style="display:none;">
                <div class="page-range-container">
                    <label class="form-label small text-muted mb-1" th:text="#{app.insights.pageRange}">Target Page Range:</label>
                    <form th:action="@{/reality-check}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('reality-loading')" class="g-2 align-items-end">
                        <div class="col-auto"><input type="number" class="page-range-input" name="startPage" th:placeholder="#{app.gallery.page}" required></div>
                        <div class="col-auto"><input type="number" class="page-range-input" name="endPage" th:placeholder="#{app.gallery.of}" required></div>
                        <div class="col-auto"><button class="btn btn-nova btn-sm" type="submit" th:text="#{app.insights.analysis}"></button></div>
                    </form>
                </div>
                <div class="loading-overlay" id="reality-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.analysis}"></p></div>
            </div>

            <div id="insight-concept" class="insight-panel" style="display:none;">
                <div class="page-range-container">
                    <label class="form-label small text-muted mb-1" th:text="#{app.insights.pageRange}">Target Page Range:</label>
                    <form th:action="@{/concept-map}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('concept-loading')" class="g-2 align-items-end">
                        <div class="col-auto"><input type="number" class="page-range-input" name="startPage" th:placeholder="#{app.gallery.page}" required></div>
                        <div class="col-auto"><input type="number" class="page-range-input" name="endPage" th:placeholder="#{app.gallery.of}" required></div>
                        <div class="col-auto"><button class="btn btn-nova btn-sm" type="submit" th:text="#{app.insights.conceptMap}"></button></div>
                    </form>
                </div>
                <div class="loading-overlay" id="concept-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.plan}"></p></div>
                <div id="concept-graph" th:attr="data-json=${conceptMapJson}"></div>
            </div>

            <div id="insight-risk" class="insight-panel" style="display:none;">
                <form th:action="@{/risk-flags}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('risk-loading')" class="g-2 align-items-end">
                    <div class="page-range-container">
                        <label class="form-label small text-muted mb-1" th:text="#{app.insights.pageRange}">Target Page Range:</label>
                        <div class="row g-2 align-items-end">
                            <div class="col-auto"><input type="number" class="page-range-input" name="startPage" th:placeholder="#{app.gallery.page}" required></div>
                            <div class="col-auto"><input type="number" class="page-range-input" name="endPage" th:placeholder="#{app.gallery.of}" required></div>
                            <div class="col-auto"><button class="btn btn-nova btn-sm" type="submit" th:text="#{app.insights.riskAlerts}"></button></div>
                        </div>
                    </div>
                </form>
                <div class="loading-overlay" id="risk-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.insights.loading.analysis}"></p></div>
            </div>

            <!-- Shared cache gallery for insights -->
            <div class="gallery-grid">
                <div th:each="img : ${cacheImages}" class="gallery-item">
                    <a th:href="@{'/cache/' + ${cacheBookName} + '/images/' + ${img.file}}" target="_blank">
                        <img th:src="@{'/cache/' + ${cacheBookName} + '/images/' + ${img.file}}" th:alt="'Page ' + ${img.page}" class="gallery-thumb">
                    </a>
                    <span class="gallery-label" th:text="#{app.gallery.page} + ' ' + ${img.page}"></span>
                </div>
            </div>
        </section>

        <!-- STUDY -->
        <section class="section-card page-section" id="study">
            <div class="section-title"><span>🧪</span> <span th:text="#{app.lab.title}"></span></div>
            <div class="tab-nav">
                <button class="btn btn-outline-nova btn-sm active" onclick="switchTab(this, 'study-comprehension')" th:text="#{app.lab.comprehension}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'study-search')" th:text="#{app.lab.search}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'study-plan')" th:text="#{app.lab.planning}"></button>
                <button class="btn btn-outline-nova btn-sm" onclick="switchTab(this, 'study-learning')" th:text="#{app.lab.plan}"></button>
            </div>

            <div id="study-comprehension" class="insight-panel">
                <div class="page-range-container">
                    <label class="form-label small text-muted mb-1" th:text="#{app.lab.pageRange}">Target Page Range:</label>
                        <form th:action="@{/comprehension}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('comp-loading')" class="g-2 align-items-end">
                        <input type="hidden" name="outputLanguage" th:value="${uiLanguage}">
                        <div class="col-auto"><input type="number" class="page-range-input" name="startPage" th:placeholder="#{app.gallery.page}" required></div>
                        <div class="col-auto"><input type="number" class="page-range-input" name="endPage" th:placeholder="#{app.gallery.of}" required></div>
                        <div class="col-auto"><button class="btn btn-nova btn-sm" type="submit" th:text="#{app.lab.comprehensionTest}"></button></div>
                    </form>
                </div>
                <div class="loading-overlay" id="comp-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.plan}"></p></div>
            </div>

            <div id="study-search" class="insight-panel" style="display:none;">
                <form th:action="@{/semantic-search}" method="post" onsubmit="sessionStorage.setItem('bookmindJustSubmitted','true'); return showLoading('search-loading')">
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" name="query" th:placeholder="#{app.lab.search}" required>
                        <button class="btn btn-nova" type="submit" th:text="#{app.lab.search}"></button>
                    </div>
                </form>
                <div class="loading-overlay" id="search-loading"><div class="spinner"></div><p class="mt-2" th:text="#{app.lab.loading.search}"></p></div>

            </div>
            <div id="study-plan" class="insight-panel" style="display:none;">
                <div class="page-range-container">
                    <label class="form-label small text-muted mb-1" th:text="#{app.lab.pageRange}">Target Page Range:</label>
