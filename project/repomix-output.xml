    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.status-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
}

.lang-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: var(--bg-primary);
    font-weight: 600;
}

/* Cards */
.card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    transition: all var(--transition-normal);
}

.card:hover {
    border-color: var(--border-light);
}

/* Upload Section */
.upload-section.has-book {
    text-align: center;
    margin: 20px 0;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 8px;
    border: 1px solid #dee2e6;
    border-color: var(--success);
    background: linear-gradient(135deg, var(--bg-card), rgba(16, 185, 129, 0.05));
}

.upload-header {
    margin-bottom: var(--spacing-lg);
}

.upload-header h2 {
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
}

.subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.upload-form {
    max-width: 500px;
    margin: 20px 0;
}

/* Drop Zone */
.drop-zone {
    border: 2px dashed #ccc;
    border-radius: 8px;
    padding: 40px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    background: white;
    position: relative;
}

.drop-zone:hover {
    border-color: #007bff;
    background-color: #f8f9fa;
}

.drop-zone.drag-over {
    border-color: #007bff;
    background-color: #e3f2fd;
    transform: scale(1.02);
}

.drop-zone input[type="file"] {
    position: absolute;
    width: 0.1px;
    height: 0.1px;
    opacity: 0;
    overflow: hidden;
}

.drop-zone-content {
    display: block;
    margin-bottom: 15px;
    margin: 10px 0;
    color: #495057;
    flex-direction: column;
    font-size: 3rem;
    align-items: center;
    gap: var(--spacing-sm);
}

.drop-zone-content small {
    color: #6c757d;
}

.upload-btn {
    width: 100%;
    margin-top: 15px;
}

.drop-icon {
    font-size: 3rem;
    margin-bottom: var(--spacing-xs);
}

.drop-text {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 500;
}

.drop-subtext {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.file-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
    background: rgba(16, 185, 129, 0.1);
    border-radius: var(--radius-md);
    color: var(--success);
    font-size: 0.9rem;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-fast);
    font-family: inherit;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: var(--bg-primary);
    box-shadow: 0 4px 15px var(--accent-glow);
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--accent-glow);
}

.btn-tool {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    width: 100%;
    margin-top: var(--spacing-sm);
}

.btn-tool:hover:not(:disabled) {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    transform: translateY(-1px);
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

/* Alerts */
.alert {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: 12px 16px;
    border-radius: 4px;
    margin: 10px 0;
    margin-top: var(--spacing-md);
    font-weight: 500;
}

.alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid var(--error);
    color: #fca5a5;
}

.alert-success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}

.alert-danger {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
}

.alert-icon {
    font-size: 1.2rem;
}

/* Language Section */
.lang-section {
    background: linear-gradient(135deg, var(--bg-card), rgba(245, 158, 11, 0.05));
    border-color: var(--accent-primary);
}

.lang-header h3 {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 1.1rem;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
}

.lang-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
}

.lang-option {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.lang-option label {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.lang-select {
    padding: 0.5rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.9rem;
    cursor: pointer;
    min-width: 120px;
}

.lang-select:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

/* Accordion */
.accordion-container {
    margin-top: var(--spacing-xl);
}

.accordion-group {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-bottom: var(--spacing-md);
    overflow: hidden;
    transition: all var(--transition-normal);
}

.accordion-group.active {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
}

.accordion-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg);
    cursor: pointer;
    background: var(--bg-card);
    transition: background var(--transition-fast);
}

.accordion-header:hover {
    background: var(--bg-hover);
}

.accordion-title {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.accordion-icon {
    font-size: 1.5rem;
}

.accordion-title h3 {
    font-size: 1.2rem;
    color: var(--text-primary);
    font-weight: 600;
}

.accordion-arrow {
    font-size: 1.2rem;
    color: var(--text-muted);
    transition: transform var(--transition-normal);
}

.accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-slow);
}

.accordion-content.active {
    max-height: 2000px;
}

/* Tool Cards */
.tool-card {
    padding: var(--spacing-lg);
    border-top: 1px solid var(--border-color);
}

.tool-card:first-child {
    border-top: none;
}

.tool-header h4 {
    font-size: 1.05rem;
    color: var(--text-primary);
    margin-bottom: var(--spacing-md);
    font-weight: 600;
}

.form-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
}

.form-group {
    flex: 1;
    min-width: 120px;
}

.form-group-full {
    flex: 1 1 100%;
}

.form-group label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: var(--spacing-xs);
}

.form-group input[type="number"],
.form-group input[type="text"] {
    width: 100%;
    padding: 0.7rem 1rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.95rem;
    transition: all var(--transition-fast);
}

.form-group input:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px var(--accent-glow);
}

/* Results */
.result-container {
    margin-top: var(--spacing-md);
}

.result-container .chat-message {
    margin-top: 0;
}

.result-container.highlight .chat-message {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
    animation: highlight 2s ease;
}

@keyframes highlight {
    0%, 100% { box-shadow: var(--shadow-glow); }
    50% { box-shadow: 0 0 30px var(--accent-glow); }
}

.no-result {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-style: italic;
    text-align: center;
    padding: var(--spacing-lg);
}

/* Loading Spinner */
.spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* Footer */
.footer {
    margin-top: var(--spacing-xl);
    padding: var(--spacing-lg) 0;
    text-align: center;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
}

.footer p {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
}

.footer-separator {
    color: var(--border-light);
}

.footer a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
}

.footer a:hover {
    color: var(--accent-secondary);
}

/* Responsive */
@media (max-width: 768px) {
    .header-content {
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .main-nav {
        width: 100%;
        justify-content: center;
    }

    .logo {
        flex-direction: column;
        text-align: center;
    }

    .book-status {
        width: 100%;
        justify-content: center;
    }
    
    .lang-controls {
        flex-direction: column;
        gap: var(--spacing-md);
    }
    
    .form-row {
        flex-direction: column;
    }
    
    .form-group {
        width: 100%;
    }
    
    .accordion-header {
        padding: var(--spacing-md);
    }
    
    .accordion-title h3 {
        font-size: 1rem;
    }
    
    .tool-card {
        padding: var(--spacing-md);
    }
}

/* RTL/LTR Adjustments */
body[dir="ltr"] .lang-badge {
    margin-left: auto;
}

body[dir="rtl"] .lang-badge {
    margin-right: auto;
}

/* Image Gallery */
.image-gallery {
    margin-top: var(--spacing-lg);
    padding: var(--spacing-md);
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
}

.image-gallery h6 {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: var(--spacing-sm);
}

.gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
}

.gallery-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 120px;
}

.gallery-thumb {
    width: 120px;
    height: 90px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-light);
    cursor: pointer;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.gallery-thumb:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-glow);
}

.gallery-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 4px;
    text-align: center;
}
</file>

<file path="src/main/resources/templates/accounts/index.html">
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns:th="http://www.thymeleaf.org"
      th:lang="${langAttr}" th:dir="${dirAttr}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="#{accounts.title}"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <style>
        body { background-color: #0f0a1e; font-family: 'Cairo', sans-serif; }
        .auth-container { max-width: 700px; margin: 60px auto; padding: 0 1rem; }
        .auth-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 2rem;
        }
        .auth-card h2 { color: #e2e8f0; font-weight: 700; }
        .platform-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 0.75rem;
            padding: 1.25rem;
            transition: all 0.2s;
        }
        .platform-card:hover { border-color: #7c3aed; }
        .btn-nova {
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            color: #fff; border: none; border-radius: 0.5rem;
            padding: 0.5rem 1rem; font-weight: 600;
        }
        .btn-nova:hover { color: #fff; box-shadow: 0 4px 15px rgba(124,58,237,0.3); }
        .btn-outline-nova {
            border: 1px solid #7c3aed; color: #a78bfa; border-radius: 0.5rem; background: transparent;
        }
        .btn-outline-nova:hover { background: #7c3aed; color: #fff; }
        .alert-success { background: rgba(16,185,129,0.1); border-color: rgba(16,185,129,0.3); color: #6ee7b7; }
        .alert-danger { background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.3); color: #fca5a5; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h2>👤 <span th:text="#{accounts.title}"></span></h2>
                    <p class="text-muted small" th:text="#{accounts.currentAccount}"></p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm lang-switch" style="width:auto;background:#1a1a2e;color:#e2e8f0;border:1px solid #2d2d44;" onchange="if(this.value)window.location.href='/language/switch?lang='+this.value+'&redirect=/accounts'">
                        <option value="" th:text="#{navbar.language}"></option>
                        <option value="ar" th:text="#{lang.ar}"></option>
                        <option value="en" th:text="#{lang.en}"></option>
                        <option value="es" th:text="#{lang.es}"></option>
                        <option value="es-MX" th:text="#{lang.es-MX}"></option>
                        <option value="fr" th:text="#{lang.fr}"></option>
                        <option value="de" th:text="#{lang.de}"></option>
                        <option value="de-AT" th:text="#{lang.de-AT}"></option>
                        <option value="it" th:text="#{lang.it}"></option>
                        <option value="nl" th:text="#{lang.nl}"></option>
                        <option value="pt" th:text="#{lang.pt}"></option>
                        <option value="ru" th:text="#{lang.ru}"></option>
                        <option value="uk" th:text="#{lang.uk}"></option>
                        <option value="af" th:text="#{lang.af}"></option>
                        <option value="zh" th:text="#{lang.zh}"></option>
                        <option value="ja" th:text="#{lang.ja}"></option>
                    </select>
                    <a th:href="@{/app}" class="btn btn-outline-nova btn-sm" th:text="#{accounts.backToApp}"></a>
                </div>
            </div>

            <div th:if="${success != null}" class="alert alert-success" th:text="${success}"></div>
            <div th:if="${error != null}" class="alert alert-danger" th:text="${error}"></div>

            <div th:if="${isLoggedIn}" class="platform-card mb-3">
                <h5 class="mb-1">📧 <span th:text="#{accounts.email}"></span></h5>
                <p class="text-muted small mb-2" th:text="#{accounts.currentAccount}"></p>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-nova mb-2 d-inline-block" style="background:#7c3aed;" th:text="${currentUserEmail}">user@example.com</span>
                    <span class="text-muted small" th:text="#{accounts.id}"></span>: <span th:text="${currentUserId}">1</span>
                </div>
            </div>

            <div class="platform-card mb-3">
                <h5 class="mb-1">🔗 <span th:text="#{accounts.integration}"></span></h5>
                <p class="text-muted small mb-3" th:text="#{accounts.notion.desc}"></p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="platform-card">
                            <h5 class="mb-1" th:text="#{accounts.notion}"></h5>
                            <p class="text-muted small mb-3" th:text="#{accounts.notion.desc}"></p>
                             <div th:if="${notionAccounts.empty}">
                                 <a th:href="@{/oauth2/authorize(platform='notion')}" class="btn btn-nova btn-sm" th:text="#{accounts.linkNotion}"></a>
                             </div>
                             <div th:each="account : ${notionAccounts}">
                                 <div class="d-flex align-items-center gap-2">
                                     <span class="badge-nova mb-2 d-inline-block" style="background:#10b981;" th:text="#{accounts.connected}"></span>
                                     <form th:action="@{/accounts/unlink}" method="post" class="d-inline">
                                         <input type="hidden" name="platform" value="notion"/>
                                         <button class="btn btn-outline-nova btn-sm" type="submit" th:text="#{accounts.unlink}"></button>
                                     </form>
                                 </div>
                             </div>
                        </div>
                    </div>
                </div>
            </div>

            <div th:if="${syncStatus != null}" class="platform-card mb-3">
                <h5 class="mb-1">🔄 <span th:text="#{accounts.syncStatus}"></span></h5>
                <p class="text-muted small mb-2" th:text="${syncStatus}"></p>
                <div th:if="${syncCount != null}" class="text-muted small mb-2">
                    <span th:text="#{accounts.syncedNotes}"></span> <span th:text="${syncCount}">0</span>
                </div>
                <form th:action="@{/accounts/sync}" method="post" class="d-inline">
                    <button class="btn btn-nova btn-sm" type="submit" th:text="#{sync.now}"></button>
                </form>
            </div>

            <div class="d-flex gap-2 mt-4">
                <form th:if="${isLoggedIn}" th:action="@{/logout}" method="post" class="d-inline">
                    <button class="btn btn-outline-nova btn-sm" type="submit" th:text="#{accounts.logout}"></button>
                </form>
                <a th:href="@{/app}" class="btn btn-nova btn-sm" th:text="#{accounts.backToApp}"></a>
                <a th:if="${!isLoggedIn}" th:href="@{/login}" class="btn btn-nova btn-sm" th:text="#{navbar.login}"></a>
            </div>
        </div>
    </div>
    <script src="/js/ui-audit.js" defer></script>
</body>
</html>
</file>

<file path="src/main/resources/templates/admin/console.html">
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console Output - BookMind Nexus</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0f0a1e; color: #e2e8f0; font-family: 'Courier New', monospace; }
        .console-container { max-width: 1400px; margin: 40px auto; padding: 0 1rem; }
        .console-header {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .console-header h1 { color: #e2e8f0; font-size: 1.5rem; }
        .stats-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 0.75rem;
            padding: 1rem;
            text-align: center;
        }
        .stats-card .count { font-size: 2rem; font-weight: 700; }
        .stats-card .label { color: #9ca3af; font-size: 0.85rem; }
        .stats-error .count { color: #fca5a5; }
        .stats-warn .count { color: #fcd34d; }
        .stats-info .count { color: #6ee7b7; }
        .filters {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 0.75rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .console-entry {
            background: #0f0a1e;
            border: 1px solid #2d2d44;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            font-size: 0.85rem;
            line-height: 1.6;
            word-wrap: break-word;
        }
        .console-entry:hover { border-color: #7c3aed; }
        .entry-level {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 600;
            margin-right: 0.75rem;
        }
        .level-ERROR { background: rgba(239,68,68,0.2); color: #fca5a5; }
        .level-WARN { background: rgba(252,211,77,0.2); color: #fcd34d; }
        .level-INFO { background: rgba(110,231,183,0.2); color: #6ee7b7; }
        .level-DEBUG { background: rgba(96,165,250,0.2); color: #93c5fd; }
        .level-TRACE { background: rgba(156,163,175,0.2); color: #d1d5db; }
        .entry-time { color: #6b7280; font-size: 0.75rem; margin-left: 0.75rem; }
        .entry-source { color: #a78bfa; font-size: 0.75rem; margin-left: 0.75rem; }
        .entry-message { color: #e2e8f0; margin-top: 0.25rem; white-space: pre-wrap; }
        .nav-link { color: #9ca3af; text-decoration: none; }
        .nav-link:hover { color: #e2e8f0; }
    </style>
</head>
<body>
    <div class="console-container">
        <div class="console-header d-flex justify-content-between align-items-center">
            <div>
                <h1>🖥️ Console Output</h1>
                <p class="text-muted small mb-0">Real-time capture of application console output</p>
            </div>
            <div>
                <a href="/app" class="btn btn-outline-nova btn-sm">← Back to App</a>
            </div>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <div class="stats-card stats-error">
                    <div class="count" th:text="${errorCount}">0</div>
                    <div class="label">Errors</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card stats-warn">
                    <div class="count" th:text="${warnCount}">0</div>
                    <div class="label">Warnings</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card stats-info">
                    <div class="count" th:text="${infoCount}">0</div>
                    <div class="label">Info</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stats-card">
                    <div class="count" th:text="${totalEntries}">0</div>
                    <div class="label">Total Entries</div>
                </div>
            </div>
        </div>

        <div class="filters">
            <form method="get" action="/admin/console" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small text-muted">Filter by Level</label>
                    <select name="level" class="form-select form-select-sm" style="background:#0f0a1e;color:#e2e8f0;border:1px solid #2d2d44;">
                        <option value="">All Levels</option>
                        <option value="ERROR" th:selected="${selectedLevel == 'ERROR'}">ERROR</option>
                        <option value="WARN" th:selected="${selectedLevel == 'WARN'}">WARN</option>
                        <option value="INFO" th:selected="${selectedLevel == 'INFO'}">INFO</option>
                        <option value="DEBUG" th:selected="${selectedLevel == 'DEBUG'}">DEBUG</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-nova btn-sm" type="submit">Filter</button>
                </div>
                <div class="col-auto">
                    <a href="/admin/console" class="btn btn-outline-nova btn-sm">Clear</a>
                </div>
            </form>
        </div>

        <div th:if="${entries.empty}">
            <div class="alert alert-info">No console entries captured yet.</div>
        </div>

        <div th:each="entry : ${entries}">
            <div class="console-entry">
                <div>
                    <span class="entry-level" th:classappend="'level-' + ${entry.level}" th:text="${entry.level}">INFO</span>
                    <span class="entry-time" th:text="${#temporals.format(entry.occurredAt, 'yyyy-MM-dd HH:mm:ss')}">2026-01-01 00:00:00</span>
                    <span class="entry-source" th:text="${entry.source}">STDOUT</span>
                </div>
                <div class="entry-message" th:text="${entry.message}"></div>
            </div>
        </div>

        <nav th:if="${entries.size() >= 100}" aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item">
                    <a class="page-link" th:href="@{/admin/console(page=${currentPage - 1})}">Previous</a>
                </li>
                <li class="page-item active">
                    <a class="page-link" th:href="@{/admin/console(page=${currentPage})}" th:text="${currentPage + 1}">1</a>
                </li>
                <li class="page-item">
                    <a class="page-link" th:href="@{/admin/console(page=${currentPage + 1})}">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</body>
</html>
</file>

