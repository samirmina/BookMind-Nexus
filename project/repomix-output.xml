    <script>
        function switchLang(lang) {
            const isAr = lang === 'ar';
            const html = document.getElementById('htmlRoot');
            html.setAttribute('lang', lang);
            html.setAttribute('dir', isAr ? 'rtl' : 'ltr');
            document.body.style.fontFamily = isAr ? "'Cairo', sans-serif" : "'Inter', sans-serif";

            // Update all buttons
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', (btn.textContent.trim() === 'ع') === isAr);
            });

            // Update all translatable elements
            document.querySelectorAll('[data-ar][data-en]').forEach(el => {
                const text = isAr ? el.getAttribute('data-ar') : el.getAttribute('data-en');
                el.innerHTML = text;
            });

            localStorage.setItem('lang', lang);
        }

        // Load saved language on page load
        const saved = localStorage.getItem('lang');
        if (saved && saved !== 'ar') switchLang(saved);
    </script>
