<file path="src/main/java/com/bookassistant/service/file/OnDemandExtractionService.java">
package com.bookassistant.service.file;

import com.bookassistant.model.BookData;
import com.bookassistant.model.PageData;
import com.bookassistant.service.config.RuntimeConfigService;
import com.bookassistant.service.infrastructure.ExtractionCacheService;
import com.bookassistant.service.infrastructure.RuntimeLogService;
import com.bookassistant.util.LoggingUtils;
import com.bookassistant.service.file.PdfEncodingDecoder;
import org.apache.pdfbox.Loader;
import org.apache.pdfbox.pdmodel.PDDocument;
import com.bookassistant.service.file.CustomMathAwareTextStripper;
import com.bookassistant.service.file.PdfEncodingDecoder;
import org.apache.pdfbox.text.PDFTextStripper;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.io.IOException;
import java.util.ArrayList;
import java.util.List;

/**
 * Extracts text from specific pages of a saved PDF on demand.
 * <p>
 * <b>What:</b> Reads a PDF from disk and extracts text from a requested
 * page range using the coordinated PDFBox + Pix2Text pipeline.
 * <p>
 * <b>Why:</b> Avoids extracting the entire book at upload time. The user
 * selects which pages to analyze, and only those pages are processed.
 * <p>
 * <b>Where:</b> Called by AI controllers before generating summaries,
 * answers, or analysis.
 */
@Service
public class OnDemandExtractionService {

    private static final Logger log = LoggerFactory.getLogger(OnDemandExtractionService.class);
    private static final String COMPONENT = "OnDemandExtractionService";

    private final BookStorageService bookStorageService;
    private final RuntimeConfigService runtimeConfigService;
    private final ExtractionCacheService extractionCacheService;
    private final RuntimeLogService runtimeLogService;
    private final MarkerExtractionClient markerClient;
    private final ChunkExtractionCoordinator chunkExtractionCoordinator;

    public OnDemandExtractionService(BookStorageService bookStorageService,
                                     RuntimeConfigService runtimeConfigService,
                                     ExtractionCacheService extractionCacheService,
                                     RuntimeLogService runtimeLogService,
                                     MarkerExtractionClient markerClient,
                                     ChunkExtractionCoordinator chunkExtractionCoordinator) {
        this.bookStorageService = bookStorageService;
        this.runtimeConfigService = runtimeConfigService;
        this.extractionCacheService = extractionCacheService;
        this.runtimeLogService = runtimeLogService;
        this.markerClient = markerClient;
        this.chunkExtractionCoordinator = chunkExtractionCoordinator;
    }

    /**
     * Extracts text from a specific page range of a saved book.
     *
     * @param bookId    the persisted book ID
     * @param startPage 1-based start page (inclusive)
     * @param endPage   1-based end page (inclusive)
     * @return BookData containing only the requested pages
     * @throws IOException if the PDF cannot be read
     */
    public BookData extractPages(long bookId, int startPage, int endPage) throws IOException {
        runtimeLogService.info(COMPONENT, String.valueOf(bookId), "Extracting pages", java.util.Map.of(
                "startPage", startPage,
                "endPage", endPage
        ));

        java.util.Optional<byte[]> pdfBytesOpt = bookStorageService.loadPdf(bookId);
        if (pdfBytesOpt.isEmpty()) {
            throw new IOException("Book PDF not found on disk | bookId=" + bookId);
        }

        byte[] bytes = pdfBytesOpt.get();
        String effectiveMode = runtimeConfigService.getExtractionMode();
        log.info("Extracting pages {}-{} from book {} | mode={}", startPage, endPage, bookId, effectiveMode);

        // Use the coordinator for PDFBox + Pix2Text pipeline with validation
        BookData extracted = chunkExtractionCoordinator.extractValidatedChunk(bytes, startPage, endPage);
        List<PageData> pages = extracted != null ? extracted.pages() : List.of();

        // Fallback to Marker if coordinator returned nothing and mode is marker
        if (pages.isEmpty() && "marker".equalsIgnoreCase(effectiveMode)) {
            log.info("Coordinator returned empty, falling back to Marker extraction");
            pages = extractWithMarker(bytes, startPage, endPage);
        }

        String fullText = combineText(pages);
        runtimeLogService.info(COMPONENT, String.valueOf(bookId), "Pages extracted", java.util.Map.of(
                "pagesExtracted", pages.size(),
                "textLength", fullText.length()
        ));

        return new BookData("pages-" + startPage + "-" + endPage, pages, fullText);
    }

    private List<PageData> extractWithMarker(byte[] bytes, int startPage, int endPage) throws IOException {
        String hash = extractionCacheService.computeHash(bytes);
        try {
            var cached = extractionCacheService.load(hash);
            if (cached != null && cached.hasContent()) {
                return filterPages(cached.pages(), startPage, endPage);
            }
        } catch (Exception e) {
            log.warn("Cache lookup failed for on-demand Marker extraction", e);
        }

        String fileName = "upload.pdf";
        java.util.List<MarkerExtractionClient.PageInfo> pageInfos =
                markerClient.extractPages(bytes, fileName, startPage, endPage);

        List<PageData> pages = new ArrayList<>();
        for (MarkerExtractionClient.PageInfo info : pageInfos) {
            pages.add(new PageData(info.pageNumber, info.text));
        }
        return pages;
    }

    private List<PageData> filterPages(List<PageData> allPages, int startPage, int endPage) {
        return allPages.stream()
                .filter(p -> p.pageNumber() >= startPage && p.pageNumber() <= endPage)
                .toList();
    }

    private String combineText(List<PageData> pages) {
        StringBuilder full = new StringBuilder();
        for (PageData page : pages) {
            if (page.hasText()) {
                full.append(page.text()).append("\n\n");
            }
        }
        return full.toString();
    }
}
