"""
BookMind Nexus Extraction Service
==================================
Accepts PDF uploads via HTTP and returns extracted text with LaTeX math notation.
Supports both Marker and Pix2Text extraction backends.

Usage:
    python main.py

Endpoints:
    POST /extract/pdf
        Upload a PDF file, receive extracted text chunks in response using Marker.

    POST /extract/pix2text
        Upload a PDF file, receive extracted text chunks using Pix2Text.

    GET /health
        Health check endpoint.
"""

import tempfile
import os
import re
import logging
from pathlib import Path
from typing import List, Optional

from fastapi import FastAPI, UploadFile, File, HTTPException, Query
from fastapi.responses import JSONResponse
from pydantic import BaseModel

logger = logging.getLogger("uvicorn")
logging.basicConfig(level=logging.INFO)

app = FastAPI(
    title="BookMind Nexus Extraction Service",
    description="Extracts text and math notation from PDFs using Marker or Pix2Text.",
    version="2.0.0",
)

# --- Marker state ---
model_dict = None


def get_models():
    """Lazy-load Marker models on first request."""
    global model_dict
    if model_dict is None:
        logger.info("Loading Marker models...")
        from marker.models import create_model_dict
        model_dict = create_model_dict()
        logger.info("Marker models loaded.")
    return model_dict


# --- Models ---

class ExtractionResponse(BaseModel):
    """Single extracted text chunk."""
    page: int
    text: str
    metadata: Optional[dict] = None


class ExtractionResult(BaseModel):
    """Full extraction result."""
    filename: str
    pages: int
    chunks: List[ExtractionResponse]
    raw_markdown: Optional[str] = None


# --- Helpers ---

def _split_into_pages(text: str) -> List[str]:
    """
    Split extracted markdown text into page-like chunks.

    Strategy:
    1. If form-feed characters (\\f) exist, split by them after stripping leading/trailing ones.
    2. Else, split by markdown horizontal rules (---, ***, ___) on their own lines.
    3. Else, split by markdown headers (## or ###) which often indicate new pages/sections.
    4. If still too few chunks, split by approximate page size (~3000 chars)
       respecting paragraph boundaries (double newlines).
    """
    if not text or not text.strip():
        return []

    # Strategy 1: form feeds
    if "\f" in text:
        stripped = text.strip("\f")
        parts = stripped.split("\f")
        return [p.strip() for p in parts if p.strip()]

    # Strategy 2: horizontal rules on their own lines
    hr_pattern = re.compile(r'^\s*(?:---|\*\*\*|___)\s*$', re.MULTILINE)
    if hr_pattern.search(text):
        parts = hr_pattern.split(text)
        return [p.strip() for p in parts if p.strip()]

    # Strategy 3: markdown headers (## or ###) as page boundaries
    header_pattern = re.compile(r'^\s*#{2,3}\s+', re.MULTILINE)
    if header_pattern.search(text):
        parts = header_pattern.split(text)
        # Keep the header with the following text
        result = []
        for i, part in enumerate(parts):
            part = part.strip()
            if part:
                result.append(part)
        return result

    # Strategy 4: split by approximate page size
    paragraphs = text.split("\n\n")
    chunks = []
    current_chunk = []
    current_size = 0
    target_size = 3000

    for para in paragraphs:
        para = para.strip()
        if not para:
            continue
        current_chunk.append(para)
        current_size += len(para)

        if current_size >= target_size:
            chunks.append("\n\n".join(current_chunk))
            current_chunk = []
            current_size = 0

    if current_chunk:
        chunks.append("\n\n".join(current_chunk))

    return chunks


def _pdf_to_images(pdf_path: str) -> List:
    """Convert PDF pages to PIL Images using pypdfium2 (no poppler required)."""
    import pypdfium2
    pdf = pypdfium2.PdfDocument(pdf_path)
    images = []
    for page in pdf:
        bitmap = page.render(scale=2)
        images.append(bitmap.to_pil())
    pdf.close()
    return images


def _extract_text_from_pix2text_result(result) -> str:
    """
    Extract readable text from Pix2Text result object.
    Pix2Text returns markdown-like output with LaTeX math blocks.
    """
    text = None
    if hasattr(result, 'markdown') and result.markdown:
        text = result.markdown
    elif hasattr(result, 'text') and result.text:
        text = result.text

    if text is None:
        text = str(result)
        # Strip any DTO/metadata leakage from stringified objects
        text = re.sub(r'\s*box\s*:\s*\[[^\]]*\]', '', text)
        text = re.sub(r'\s*score\s*:\s*[^,\}\s]+', '', text)
        text = re.sub(r'\s*position\s*:\s*[^,\}\s]+', '', text)
        text = re.sub(r'\s*id\s*:\s*[^,\}\s]+', '', text)

    # Clean up excessive newlines while preserving structure
    text = re.sub(r'\n{3,}', '\n\n', text)
    return text.strip()


# --- Marker endpoint ---

@app.post("/extract/pdf", response_model=ExtractionResult)
async def extract_pdf(
    file: UploadFile = File(...),
    start_page: int = Query(0, ge=0),
    end_page: int = Query(0, ge=0)
):
    """
    Accepts a PDF file upload, extracts text with LaTeX math notation using Marker,
    and returns structured page chunks.
    
    Optional query parameters:
    - start_page: 1-based start page (inclusive). 0 means start from first page.
    - end_page: 1-based end page (inclusive). 0 means process all pages.
    """
    if not file.filename.lower().endswith(".pdf"):
        raise HTTPException(status_code=400, detail="Only PDF files are supported.")

    tmp_path = None
    try:
        # Save uploaded file to temp location
        suffix = Path(file.filename).suffix
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
            content = await file.read()
            tmp.write(content)
            tmp_path = tmp.name

        logger.info("Processing PDF with Marker: %s", file.filename)

        # Run Marker extraction using new class-based API
        models = get_models()
        from marker.config.parser import ConfigParser
        from marker.converters.pdf import PdfConverter
        config_parser = ConfigParser({})
        converter = PdfConverter(
            config=config_parser.generate_config_dict(),
            artifact_dict=models,
            processor_list=config_parser.get_processors(),
            renderer=None,
            llm_service=config_parser.get_llm_service(),
        )
        rendered = converter(tmp_path)
        full_text = rendered.markdown if hasattr(rendered, 'markdown') else str(rendered)

        # Split into page chunks.
        # Marker may return a single markdown blob without form-feed page breaks.
        # We try multiple strategies to recover page-like boundaries.
        chunks: List[ExtractionResponse] = []
        raw_pages = _split_into_pages(full_text)

        for idx, page_text in enumerate(raw_pages, start=1):
            if start_page > 0 and idx < start_page:
                continue
            if end_page > 0 and idx > end_page:
                break
            
            text = page_text.strip()
            if text:
                chunks.append(
                    ExtractionResponse(
                        page=idx,
                        text=text,
                        metadata={"chars": len(text)},
                    )
                )

        logger.info(
            "Marker extraction complete | pages=%d | chunks=%d | range=%d-%d | file=%s",
            len(raw_pages), len(chunks), start_page, end_page, file.filename,
        )

        return ExtractionResult(
            filename=file.filename,
            pages=len(chunks),
            chunks=chunks,
            raw_markdown=full_text,
        )

    except Exception as exc:
        logger.exception("Failed to extract PDF with Marker: %s", exc)
        raise HTTPException(status_code=500, detail=str(exc)) from exc

    finally:
        # Clean up temp file
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


# --- Pix2Text endpoint ---

@app.post("/extract/pix2text", response_model=ExtractionResult)
async def extract_pix2text(
    file: UploadFile = File(...),
    start_page: int = Query(0, ge=0),
    end_page: int = Query(0, ge=0)
):
    """
    Accepts a PDF file upload, extracts text and math notation using Pix2Text,
    and returns structured page chunks with LaTeX math notation.
    
    Optional query parameters:
    - start_page: 1-based start page (inclusive). 0 means start from first page.
    - end_page: 1-based end page (inclusive). 0 means process all pages.
    """
    if not file.filename.lower().endswith(".pdf"):
        raise HTTPException(status_code=400, detail="Only PDF files are supported.")

    tmp_path = None
    try:
        # Save uploaded file to temp location
        suffix = Path(file.filename).suffix
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as tmp:
            content = await file.read()
            tmp.write(content)
            tmp_path = tmp.name

        logger.info("Processing PDF with Pix2Text: %s", file.filename)

        # Initialize Pix2Text with GPU support and more sensitive math/table detection
        from pix2text import Pix2Text
        p2t = Pix2Text.from_config(
            device='cuda',
            enable_formula=True,
            enable_table=True,
            mfd_config={"confidence_threshold": 0.25},
        )

        def _recognize_page(image, page_number):
            return p2t.recognize_page(
                image,
                page_number=page_number,
                resized_shape=1280,
                mfr_batch_size=8,
            )

        # Convert PDF pages to images
        images = _pdf_to_images(tmp_path)
        logger.info("Converted PDF to %d images", len(images))

        chunks: List[ExtractionResponse] = []

        for page_idx, image in enumerate(images, start=1):
            if start_page > 0 and page_idx < start_page:
                continue
            if end_page > 0 and page_idx > end_page:
                break
            
            try:
                result = _recognize_page(image, page_idx)
                page_text = _extract_text_from_pix2text_result(result)
                
                if page_text.strip():
                    chunks.append(
                        ExtractionResponse(
                            page=page_idx,
                            text=page_text.strip(),
                            metadata={
                                "chars": len(page_text),
                                "backend": "pix2text",
                            },
                        )
                    )
            except Exception as page_exc:
                logger.warning(
                    "Pix2Text failed on page %d: %s", page_idx, page_exc
                )
                continue

        logger.info(
            "Pix2Text extraction complete | pages=%d | range=%d-%d | file=%s",
            len(chunks), start_page, end_page, file.filename,
        )

        if not chunks:
            raise HTTPException(
                status_code=500,
                detail="Pix2Text produced no output. Check that the models are downloaded.",
            )

        # Combine all page texts for raw_markdown
        full_text = '\n\n'.join(c.text for c in chunks)

        return ExtractionResult(
            filename=file.filename,
            pages=len(chunks),
            chunks=chunks,
            raw_markdown=full_text,
        )

    except HTTPException:
        raise
    except Exception as exc:
        logger.exception("Failed to extract PDF with Pix2Text: %s", exc)
        raise HTTPException(status_code=500, detail=str(exc)) from exc

    finally:
        # Clean up temp file
        if tmp_path and os.path.exists(tmp_path):
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


@app.get("/health")
def health():
    """Health check."""
    return {"status": "ok"}
