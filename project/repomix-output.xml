<file path="src/main/java/com/bookassistant/service/file/FileParserService.java">
package com.bookassistant.service.file;

import com.bookassistant.model.BookData;
import com.bookassistant.model.ExtractionCacheEntry;
import com.bookassistant.model.PageData;
import com.bookassistant.service.config.RuntimeConfigService;
import com.bookassistant.service.infrastructure.ExtractionCacheService;
import com.bookassistant.service.infrastructure.RuntimeLogService;
import com.bookassistant.util.LoggingUtils;
import com.bookassistant.service.file.CustomMathAwareTextStripper;
import com.bookassistant.service.file.PdfEncodingDecoder;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.MessageSource;
import org.springframework.context.i18n.LocaleContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.web.multipart.MultipartFile;

import java.io.IOException;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;

/**
 * Parses uploaded PDF files into structured book data.
 *
 * <p><b>Extraction modes:</b></p>
 * <ul>
 *   <li>{@code text-layer} — PDFBox text-layer extraction (fast, no math notation)</li>
 *   <li>{@code marker} — Marker microservice extraction (slower, full LaTeX math)</li>
 * </ul>
 */
@Service
public class FileParserService {

    private static final Logger log = LoggerFactory.getLogger(FileParserService.class);
    private static final long MAX_FILE_SIZE = 200 * 1024 * 1024;

    private final MessageSource messageSource;
    private final MarkerExtractionClient markerClient;
    private final Pix2TextExtractionClient pix2textClient;
    private final RuntimeConfigService runtimeConfigService;
    private final ExtractionCacheService extractionCacheService;
    private final RuntimeLogService runtimeLogService;
    private static final String COMPONENT_PARSER = "FileParserService";
    private static final java.util.concurrent.ThreadPoolExecutor PIX2TEXT_EXECUTOR = new java.util.concurrent.ThreadPoolExecutor(
            4, 8, 60L, java.util.concurrent.TimeUnit.SECONDS,
            new java.util.concurrent.LinkedBlockingQueue<>(50),
            r -> new Thread(r, "pix2text-worker-" + System.currentTimeMillis()),
            new java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy()
    );

    @Value("${app.extraction.mode:marker}")
    private String extractionMode;

    public FileParserService(MessageSource messageSource, MarkerExtractionClient markerClient, Pix2TextExtractionClient pix2textClient, RuntimeConfigService runtimeConfigService, ExtractionCacheService extractionCacheService, RuntimeLogService runtimeLogService) {
        this.messageSource = messageSource;
        this.markerClient = markerClient;
        this.pix2textClient = pix2textClient;
        this.runtimeConfigService = runtimeConfigService;
        this.extractionCacheService = extractionCacheService;
        this.runtimeLogService = runtimeLogService;
        log.info("FileParserService initialized | extractionMode={}", extractionMode);
    }

    private static Map<String, Object> safeMap(Object... keyValues) {
        Map<String, Object> map = new LinkedHashMap<>();
        for (int i = 0; i < keyValues.length; i += 2) {
            String key = (String) keyValues[i];
            Object value = keyValues[i + 1];
            map.put(key, value != null ? value : "null");
        }
        return map;
    }

    /**
     * Parses raw PDF bytes into a {@link BookData} object.
     * <p>
     * <b>What:</b> Entry point for background extraction where the request-scoped
     * {@link MultipartFile} may no longer be readable. Uses the provided fileName
     * for metadata and cache lookups.
     * <p>
     * <b>Why:</b> {@link MultipFile} implementations may release temporary storage
     * after the HTTP request completes; copying bytes in the request thread avoids
     * that race.
     *
     * @param bytes      raw PDF content
     * @param fileName   original file name for cache/metadata
     * @param progress   optional progress callback
     * @return parsed book data
     */
    public BookData parsePdfBytes(byte[] bytes, String fileName, ProgressCallback progress) throws IOException {
        LoggingUtils.enter(log, "parsePdfBytes",
                "fileName", fileName,
                "fileSize", bytes != null ? bytes.length : 0);
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "parsePdfBytes entered", safeMap(
                "fileName", fileName,
                "bytesLength", bytes != null ? bytes.length : 0
        ));

        long startTime = System.currentTimeMillis();

        if (bytes == null || bytes.length == 0) {
            runtimeLogService.warn(COMPONENT_PARSER, "unknown", "Empty bytes received");
            throw new IllegalArgumentException(messageSource.getMessage("upload.file.empty", null, LocaleContextHolder.getLocale()));
        }
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "Bytes non-null check passed", safeMap());

        String hash = extractionCacheService.computeHash(bytes);
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "Hash computed", safeMap("hash", hash));

        ExtractionCacheEntry cached = extractionCacheService.load(hash);
        if (cached != null && cached.hasContent()) {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Cache hit", safeMap(
                    "hash", hash,
                    "pages", cached.pageCount()
            ));
            log.info("Loaded cached extraction | hash={} | fileName={} | pages={} | textLen={}",
                    hash, cached.fileName(), cached.pageCount(), cached.fullText().length());
            return new BookData(cached.fileName(), cached.pages(), cached.fullText());
        }
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "Cache miss", safeMap("hash", hash));

        runtimeLogService.info(COMPONENT_PARSER, "unknown", "Before progress callback", safeMap());
        if (progress != null) {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Invoking progress callback", safeMap());
            progress.onProgress("Reading PDF", 0, 0);
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Progress callback returned", safeMap());
        } else {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "No progress callback provided", safeMap());
        }
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "After progress callback - before mode selection", safeMap());

        List<PageData> pages;
        String effectiveMode = runtimeConfigService.getExtractionMode();
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "Starting extraction", safeMap(
                "mode", effectiveMode,
                "fileName", fileName
        ));
        if ("pix2text".equalsIgnoreCase(effectiveMode)) {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Calling extractWithPix2Text", safeMap(
                    "bytesLength", bytes != null ? bytes.length : 0,
                    "fileName", fileName
            ));
            pages = extractWithPix2Text(bytes, fileName, progress);
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Returned from extractWithPix2Text", safeMap(
                    "pages", pages != null ? pages.size() : 0
            ));
        } else if ("marker".equalsIgnoreCase(effectiveMode)) {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Calling extractWithMarker", safeMap());
            pages = extractWithMarker(bytes, fileName, progress);
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Returned from extractWithMarker", safeMap(
                    "pages", pages != null ? pages.size() : 0
            ));
        } else {
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Calling extractWithPdfBox", safeMap());
            pages = extractWithPdfBox(bytes, progress);
            runtimeLogService.info(COMPONENT_PARSER, "unknown", "Returned from extractWithPdfBox", safeMap(
                    "pages", pages != null ? pages.size() : 0
            ));
        }

        if (progress != null) progress.onProgress("Saving", pages.size(), pages.size());

        String fullText = combineText(pages);
        fullText = sanitizeText(fullText);

        if (fullText == null || fullText.isBlank()) {
            String hintKey = switch (effectiveMode.toLowerCase()) {
                case "pix2text" -> "extraction.mode.pix2text.hint";
                case "surya" -> "extraction.mode.pix2text.hint";
                case "text-layer" -> "extraction.mode.pdfbox.hint";
                default -> "extraction.mode.marker.hint";
            };
            String hint = messageSource.getMessage(hintKey, null, LocaleContextHolder.getLocale());
            throw new IllegalArgumentException(messageSource.getMessage("file.no.text.extracted", null, LocaleContextHolder.getLocale()) + " " + hint);
        }

        BookData bookData = new BookData(fileName, pages, fullText);
        extractionCacheService.save(hash, fileName, effectiveMode, pages, fullText);

        long duration = System.currentTimeMillis() - startTime;
        LoggingUtils.fileOperation(log, "PARSE", fileName, fullText.length(), duration);

        log.info("PDF parsed successfully | fileName={} | pages={} | textLen={} | mode={} | duration={}ms",
                fileName, pages.size(), fullText.length(), effectiveMode, duration);

        return bookData;
    }

    /**
     * Parses a PDF multipart file into a {@link BookData} object.
     * Results are cached under {@code cache/extractions/} by PDF content hash.
     */
    public BookData parsePdfFile(MultipartFile file, ProgressCallback progress) throws IOException {
        return parsePdfBytes(file.getBytes(), file.getOriginalFilename(), progress);
    }

    /**
     * Backward-compatible overload without progress reporting.
     */
    public BookData parsePdfFile(MultipartFile file) throws IOException {
        return parsePdfFile(file, null);
    }

    // --- Extraction paths ---

    private List<PageData> extractWithMarker(byte[] bytes, String fileName, ProgressCallback progress) throws IOException {
        log.info("Using Marker extraction mode | fileName={}", fileName);
        List<MarkerExtractionClient.PageInfo> pageInfos = markerClient.extractPages(bytes, fileName);

        List<PageData> pages = new ArrayList<>();
        for (MarkerExtractionClient.PageInfo info : pageInfos) {
            pages.add(new PageData(info.pageNumber, info.text));
        }
        if (progress != null) progress.onProgress("Extracting", pages.size(), pages.size());
        return pages;
    }

    private List<PageData> extractWithPix2Text(byte[] bytes, String fileName, ProgressCallback progress) throws IOException {
        log.info("Using Pix2Text extraction mode | fileName={}", fileName);
        runtimeLogService.info(COMPONENT_PARSER, "unknown", "extractWithPix2Text started", safeMap(
                "fileName", fileName,
                "bytesLength", bytes.length
        ));

        java.util.concurrent.CompletableFuture<List<Pix2TextExtractionClient.PageInfo>> future =
                java.util.concurrent.CompletableFuture.supplyAsync(() -> {
                    runtimeLogService.info(COMPONENT_PARSER, "unknown", "Pix2Text HTTP call started", safeMap());
                    try {
                        return pix2textClient.extractPages(bytes, fileName);
                    } catch (Exception e) {
                        runtimeLogService.error(COMPONENT_PARSER, "unknown", "Pix2Text HTTP call failed", safeMap(
                                "error", e.getMessage()
                        ));
                        throw new RuntimeException(e);
                    }
                }, PIX2TEXT_EXECUTOR);

        List<Pix2TextExtractionClient.PageInfo> pageInfos;
        try {
            int waited = 0;
            while (true) {
                try {
                    pageInfos = future.get(5, java.util.concurrent.TimeUnit.SECONDS);
                    break;
                } catch (java.util.concurrent.TimeoutException e) {
                    waited += 5;
                    runtimeLogService.info(COMPONENT_PARSER, "unknown", "Pix2Text still processing", safeMap(
                            "waitedSeconds", waited
                    ));
                    if (progress != null) {
                        progress.onProgress("Processing PDF", waited, -1);
                    }
                }
            }
        } catch (Exception e) {
            future.cancel(true);
            throw new IOException("Pix2Text extraction failed: " + e.getMessage(), e);
        }

        List<PageData> pages = new ArrayList<>();
        for (Pix2TextExtractionClient.PageInfo info : pageInfos) {
            pages.add(new PageData(info.pageNumber, info.text));
        }
        if (progress != null) progress.onProgress("Extracting", pages.size(), pages.size());
        return pages;
    }

    private List<PageData> extractWithPdfBox(byte[] bytes, ProgressCallback progress) throws IOException {
        log.info("Using PDFBox text-layer extraction mode");
        try (var doc = org.apache.pdfbox.Loader.loadPDF(bytes)) {
            return extractPages(doc, progress);
        }
    }

    // --- PDFBox extraction (unchanged) ---

    private List<PageData> extractPages(org.apache.pdfbox.pdmodel.PDDocument doc, ProgressCallback progress) throws IOException {
        int pageCount = doc.getNumberOfPages();
        log.info("PDF has {} pages", pageCount);

        if (pageCount == 0) {
            throw new IllegalArgumentException(messageSource.getMessage("file.pdf.empty", null, LocaleContextHolder.getLocale()));
        }

        PdfEncodingDecoder decoder = new PdfEncodingDecoder(doc);
        org.apache.pdfbox.text.PDFTextStripper stripper = decoder.hasCustomEncodings()
                ? new CustomMathAwareTextStripper(decoder)
                : new org.apache.pdfbox.text.PDFTextStripper();

        List<PageData> pages = new ArrayList<>(pageCount);
        for (int i = 1; i <= pageCount; i++) {
            PageData page = extractPageText(stripper, doc, i);
            if (page != null) {
                pages.add(page);
            }
            if (progress != null) {
                progress.onProgress("Extracting", i, pageCount);
            }
        }
        return pages;
    }

    private PageData extractPageText(org.apache.pdfbox.text.PDFTextStripper stripper,
                                     org.apache.pdfbox.pdmodel.PDDocument doc, int pageNumber) {
        try {
            stripper.setStartPage(pageNumber);
            stripper.setEndPage(pageNumber);
            String pageText = stripper.getText(doc).trim();
            return new PageData(pageNumber, pageText);
        } catch (Exception e) {
            log.warn("Error processing page {}: {}", pageNumber, e.getMessage());
            return new PageData(pageNumber, "");
        }
    }

    // --- Helpers ---

    private String combineText(List<PageData> pages) {
        StringBuilder full = new StringBuilder();
        for (PageData page : pages) {
            if (page.hasText()) {
                full.append(page.text()).append("\n\n");
            }
        }
        return full.toString();
    }

    private void validateFile(MultipartFile file) {
        if (file.isEmpty()) {
            throw new IllegalArgumentException(messageSource.getMessage("upload.file.empty", null, LocaleContextHolder.getLocale()));
        }
        if (!"application/pdf".equals(file.getContentType())) {
            throw new IllegalArgumentException(messageSource.getMessage("upload.file.not.pdf", null, LocaleContextHolder.getLocale()));
        }
        if (file.getSize() > MAX_FILE_SIZE) {
            throw new IllegalArgumentException(messageSource.getMessage("upload.file.too.large", null, LocaleContextHolder.getLocale()));
        }
    }

    private String sanitizeText(String text) {
        if (text == null) return null;
        String cleaned = text
                .replace("\0", "")
                .replace("\uFB00", "ff")
                .replace("\uFB01", "fi")
                .replace("\uFB02", "fl")
                .replace("\uFB03", "ffi")
                .replace("\uFB04", "ffl")
                .replace("\uFB05", "st")
                .replace("\uFB06", "st");

        // Normalize known OCR artifacts from Marker/PdfBox extraction.
        cleaned = cleaned.replace("ú", "*")
                .replace("≠", "!=")
                .replace("œ", "o")
                .replace("æ", "ae")
                .replace("Ω", "Omega")
                .replace("Î", "||")
                .replace("Ô", "")
                .replace("ag8", "")
                .replace("w^u", "w^*")
                .replace("b^u", "b^*")
                .replace("wx^i", "w x^i")
                .replace("wx^i", "w x^i");

        // Strip HTML tags that Marker sometimes emits (e.g., <sup>, <sub>, <br>, <b>, <i>)
        // and convert common patterns to LaTeX equivalents.
        cleaned = cleaned.replaceAll("(?i)<br\\s*/?>", "\\\\n")
                .replaceAll("(?i)</?p[^>]*>", "\n\n")
                .replaceAll("(?i)</?div[^>]*>", "\n")
                .replaceAll("(?i)</?span[^>]*>", "");

        // Convert HTML superscript/subscript to LaTeX
        // <sup>N</sup> -> ^{N}
        java.util.regex.Pattern supPat = java.util.regex.Pattern.compile("(?i)<sup[^>]*>(.*?)</sup>");
        java.util.regex.Matcher supMat = supPat.matcher(cleaned);
        cleaned = supMat.replaceAll("^{$1}");
        
        // <sub>i</sub> -> _{i}
        java.util.regex.Pattern subPat = java.util.regex.Pattern.compile("(?i)<sub[^>]*>(.*?)</sub>");
        java.util.regex.Matcher subMat = subPat.matcher(cleaned);
        cleaned = subMat.replaceAll("_{$1}");

        // Remove any remaining HTML tags we don't explicitly convert
        cleaned = cleaned.replaceAll("(?i)<[^>]+>", "");

        // Unescape common HTML entities that may appear in math context
        cleaned = cleaned.replace("&lt;", "<")
                .replace("&gt;", ">")
                .replace("&amp;", "&")
                .replace("&nbsp;", " ")
                .replace("&deg;", "^\\circ")
                .replace("&times;", "\\times")
                .replace("&div;", "\\div")
                .replace("&alpha;", "\\alpha")
                .replace("&beta;", "\\beta")
                .replace("&gamma;", "\\gamma")
                .replace("&delta;", "\\delta")
                .replace("&epsilon;", "\\epsilon")
                .replace("&theta;", "\\theta")
                .replace("&lambda;", "\\lambda")
                .replace("&mu;", "\\mu")
                .replace("&sigma;", "\\sigma")
                .replace("&pi;", "\\pi")
                .replace("&omega;", "\\omega")
                .replace("&int;", "\\int")
                .replace("&sum;", "\\sum")
                .replace("&prod;", "\\prod")
                .replace("&frac;", "\\frac")
                .replace("&sqrt;", "\\sqrt")
                .replace("&infty;", "\\infty")
                .replace("&partial;", "\\partial")
                .replace("&nabla;", "\\nabla")
                .replace("&in;", "\\in")
                .replace("&notin;", "\\notin")
                .replace("&subset;", "\\subset")
                .replace("&supset;", "\\supset")
                .replace("&cup;", "\\cup")
                .replace("&cap;", "\\cap")
                .replace("&leq;", "\\leq")
                .replace("&geq;", "\\geq")
                .replace("&neq;", "\\neq")
                .replace("&approx;", "\\approx")
                .replace("&equiv;", "\\equiv")
                .replace("&pm;", "\\pm")
                .replace("&mp;", "\\mp")
                .replace("&times;", "\\times")
                .replace("&div;", "\\div")
                .replace("&cdot;", "\\cdot")
                .replace("&ldots;", "\\ldots")
                .replace("&cdots;", "\\cdots")
                .replace("&vdots;", "\\vdots")
                .replace("&ddots;", "\\ddots")
                .replace("&hat;", "\\hat")
                .replace("&bar;", "\\bar")
                .replace("&vec;", "\\vec")
                .replace("&dot;", "\\dot")
                .replace("&tilde;", "\\tilde")
                .replace("&widehat;", "\\widehat")
                .replace("&widetilde;", "\\widetilde")
                .replace("&frac12;", "\\frac{1}{2}")
                .replace("&frac14;", "\\frac{1}{4}")
                .replace("&frac34;", "\\frac{3}{4}")
                .replace("&frac13;", "\\frac{1}{3}")
                .replace("&frac23;", "\\frac{2}{3}")
                .replace("&frac18;", "\\frac{1}{8}")
                .replace("&frac38;", "\\frac{3}{8}")
                .replace("&frac58;", "\\frac{5}{8}")
                .replace("&frac78;", "\\frac{7}{8}")
                .replace("&#x2062;", "\\times")
                .replace("&#x2063;", "\\, ")
                .replace("&#x2064;", "\\, ");

        // Clean up double spaces and trailing whitespace
        cleaned = cleaned.replaceAll(" {2,}", " ").trim();

        return cleaned;
    }
}
