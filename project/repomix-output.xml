<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="#{outputs.title.page}"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css">
    <style>
        body { background-color: #0f0a1e; font-family: 'Cairo', sans-serif; }
        .auth-container { max-width: 900px; margin: 40px auto; padding: 0 1rem; }
        .auth-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 2rem;
        }
        .auth-card h2 { color: #e2e8f0; font-weight: 700; }
        .output-item {
            background: #0f0a1e;
            border: 1px solid #2d2d44;
            border-radius: 0.75rem;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .output-meta {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 0.5rem;
        }
        .badge-tab {
            background: #7c3aed;
            color: #fff;
            font-size: 0.75rem;
            padding: 0.35rem 0.6rem;
            border-radius: 0.375rem;
        }
        .output-text {
            background: transparent;
            border: 1px solid #2d2d44;
            border-radius: 0.5rem;
            padding: 0.75rem;
            line-height: 1.8;
            word-wrap: break-word;
            overflow-wrap: break-word;
            display: none;
            position: relative;
            color: #e2e8f0;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }
        .output-text.expanded {
            display: block;
            position: relative;
            box-shadow:
                0 0 20px rgba(255, 0, 0, 0.25),
                0 0 20px rgba(0, 136, 255, 0.2),
                0 0 20px rgba(136, 0, 255, 0.25);
            animation: ambient-breathe 4s ease-in-out infinite;
        }
        .output-text.expanded::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                ellipse at 90% 10%,
                rgba(255, 255, 255, 0.35) 0%,
                rgba(255, 200, 150, 0.12) 35%,
                transparent 65%
            );
            pointer-events: none;
            z-index: 1;
            mix-blend-mode: soft-light;
            animation: light-breathe 8s ease-in-out infinite;
        }
        .output-text.expanded > * {
            position: relative;
            z-index: 2;
        }
        @keyframes gradient-shift {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        @keyframes ambient-breathe {
            0%, 100% {
                box-shadow:
                    0 0 25px rgba(255, 0, 0, 0.25),
                    0 0 25px rgba(0, 136, 255, 0.2),
                    0 0 25px rgba(136, 0, 255, 0.25);
            }
            50% {
                box-shadow:
                    0 0 40px rgba(255, 0, 0, 0.15),
                    0 0 40px rgba(0, 136, 255, 0.3),
                    0 0 40px rgba(136, 0, 255, 0.15);
            }
        }
        @keyframes light-breathe {
            0%, 100% { opacity: 0.85; }
            50% { opacity: 1; }
        }
        .btn-nova {
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            color: #fff; border: none; border-radius: 0.5rem;
            padding: 0.5rem 1rem; font-weight: 600;
        }
        .btn-nova:hover { color: #fff; box-shadow: 0 4px 15px rgba(124,58,237,0.3); }
        .btn-delete {
            background: transparent;
            color: #ef4444;
            border: 1px solid #ef4444;
            border-radius: 0.375rem;
            padding: 0.25rem 0.6rem;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-delete:hover {
            background: #ef4444;
            color: #fff;
        }
        .delete-confirm {
            display: none;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.5rem;
            padding: 0.5rem;
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid #ef4444;
            border-radius: 0.375rem;
        }
        .delete-confirm.active {
            display: flex;
        }
        .delete-confirm span {
