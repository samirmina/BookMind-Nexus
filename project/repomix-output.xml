    <style>
        body { background-color: #0f0a1e; font-family: 'Cairo', sans-serif; }
        .auth-container { max-width: 420px; margin: 60px auto; }
        .auth-card {
            background: #1a1a2e;
            border: 1px solid #2d2d44;
            border-radius: 1rem;
            padding: 2rem;
        }
        .auth-card h3 { color: #e2e8f0; font-weight: 700; }
