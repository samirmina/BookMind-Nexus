<file path="src/main/resources/static/styles.css">
/* ===================================
   Book Assistant Lite - Modern UI
   Dark Theme with Amber/Gold Accents
   =================================== */

/* CSS Variables */
:root {
    /* Colors */
    --bg-primary: #0a0e1a;
    --bg-secondary: #111827;
    --bg-card: #1a1f2e;
    --bg-hover: #242b3d;
    --bg-code: #282c34;

    --text-primary: #f9fafb;
    --text-secondary: #d1d5db;
    --text-muted: #9ca3af;

    --accent-primary: #f59e0b;  /* Amber */
    --accent-secondary: #d97706;
    --accent-glow: rgba(245, 158, 11, 0.3);

    --success: #10b981;
    --error: #ef4444;
    --warning: #f59e0b;

    --border-color: #2d3748;
    --border-light: #374151;

    /* Spacing */
    --spacing-xs: 0.5rem;
    --spacing-sm: 0.75rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;

    /* Border Radius */
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;

    /* Shadows */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 20px var(--accent-glow);

    /* Transitions */
    --transition-fast: 0.15s ease;
    --transition-normal: 0.3s ease;
    --transition-slow: 0.5s ease;
}

.result-section {
    margin-top: 15px;
    padding: 15px;
    background-color: #f8f9fa;
    border-radius: 5px;
    border-left: 4px solid #dc3545;
}

.result-content {
    white-space: pre-wrap;
    line-height: 1.6;
}

/* ===================================
   Chat Message Component
   =================================== */

.chat-message {
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-top: var(--spacing-md);
    overflow: hidden;
    animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message-content {
    padding: var(--spacing-lg);
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.95rem;
    max-height: 500px;
    overflow-y: auto;
}

.message-content::-webkit-scrollbar {
    width: 8px;
}

.message-content::-webkit-scrollbar-track {
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
}

.message-content::-webkit-scrollbar-thumb {
    background: var(--border-light);
    border-radius: var(--radius-sm);
}

.message-content::-webkit-scrollbar-thumb:hover {
    background: var(--accent-primary);
}

/* Markdown Body Styles */
.markdown-body {
    font-family: 'Inter', 'Cairo', sans-serif;
}

.markdown-body h1,
.markdown-body h2,
.markdown-body h3,
.markdown-body h4,
.markdown-body h5,
.markdown-body h6 {
    color: var(--text-primary);
    margin-top: 1.5em;
    margin-bottom: 0.75em;
    font-weight: 600;
    line-height: 1.4;
}

.markdown-body h1 {
    font-size: 1.75rem;
    border-bottom: 2px solid var(--border-color);
    padding-bottom: 0.5em;
}

.markdown-body h2 {
    font-size: 1.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.4em;
}

.markdown-body h3 {
    font-size: 1.25rem;
}

.markdown-body h4 {
    font-size: 1rem;
}

.markdown-body p {
    margin-bottom: 1em;
}

.markdown-body ul,
.markdown-body ol {
    margin-bottom: 1em;
    padding-inline-start: 2em;
}

.markdown-body li {
    margin-bottom: 0.5em;
}

.markdown-body ul {
    list-style-type: disc;
}

.markdown-body ol {
    list-style-type: decimal;
}

.markdown-body blockquote {
    border-inline-start: 4px solid var(--accent-primary);
    padding-inline-start: 1em;
    margin: 1em 0;
    color: var(--text-muted);
    font-style: italic;
    background: rgba(245, 158, 11, 0.05);
    padding: var(--spacing-md);
    border-radius: var(--radius-sm);
}

.markdown-body code {
    font-family: 'JetBrains Mono', 'Cairo', monospace;
    background: rgba(107, 114, 128, 0.2);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    color: #f472b6;
}

.markdown-body pre {
    background: var(--bg-code);
    border-radius: var(--radius-lg);
    margin: 1em 0;
    overflow: hidden;
}

.markdown-body pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.85rem;
    line-height: 1.6;
}

.markdown-body a {
    color: var(--accent-primary);
    text-decoration: none;
    transition: color var(--transition-fast);
}

.markdown-body a:hover {
    color: var(--accent-secondary);
    text-decoration: underline;
}

.markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1em 0;
}

.markdown-body th,
.markdown-body td {
    border: 1px solid var(--border-color);
    padding: var(--spacing-sm) var(--spacing-md);
    text-align: start;
}

.markdown-body th {
    background: var(--bg-hover);
    font-weight: 600;
}

.markdown-body tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.02);
}

/* ===================================
   Code Block with Copy Button
   =================================== */

.code-block-wrapper {
    margin: 1em 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
}

.code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: #21252b;
    border-bottom: 1px solid var(--border-color);
}

.code-language {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.copy-code-btn {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.copy-code-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--accent-primary);
}

.copy-code-btn.copied {
    background: var(--success);
    border-color: var(--success);
    color: white;
}

.copy-icon {
    width: 14px;
    height: 14px;
}

.code-block {
    margin: 0;
    padding: var(--spacing-lg);
    overflow-x: auto;
    background: var(--bg-code);
}

.code-block code {
    font-family: 'JetBrains Mono', 'Consolas', 'Monaco', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    white-space: pre;
    display: block;
}

/* Syntax Highlighting Overrides */
.hljs {
    background: transparent !important;
    padding: 0 !important;
}

/* ===================================
   RTL/LTR Support for Code
   =================================== */

body[dir="rtl"] .code-block-header {
    direction: ltr;
}

body[dir="rtl"] .markdown-body pre {
    direction: ltr;
    text-align: left;
}

/* Reset & Base */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', 'Cairo', sans-serif;
    background: linear-gradient(135deg, var(--bg-primary) 0%, #1e1b2e 50%, var(--bg-secondary) 100%);
