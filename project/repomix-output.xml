version: '3'

env:
  MARKER_DIR: extraction-service
  MARKER_VENV: ../external/venv
  MARKER_PORT: 8080
  APP_PORT: 8083
  MAVEN_HOME: ../external/mvn-dist/apache-maven-3.9.12
  JAVA_HOME: E:/.jdks/ms-21.0.10
  MARKER_PYTHON: D:\book-assistant-lite\kilo_environment_data\Python312\python.exe
  PG_DIR: D:\book-assistant-lite\external\pgsql
  PG_DATA: D:\book-assistant-lite\external\pgsql\data
  PG_PORT: 5432

tasks:
  setup:
    desc: Full project setup (install deps into existing venv)
    cmds:
      - cmd /c "cd extraction-service && ""{{.MARKER_VENV}}""\Scripts\python.exe -m pip install -r requirements.txt"

  start-marker:
    desc: Start extraction service on port 8080 (stops any existing instance first)
    cmds:
      - powershell -Command '$conn = Get-NetTCPConnection -LocalPort 8080 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force; echo "Stopped existing service on 8080" } else { echo "No existing service on 8080" }'
      - powershell -Command '$env:PATH = "D:\book-assistant-lite\external\tools\cudnn\extracted\cudnn-windows-x86_64-9.25.1.1_cuda13-archive\bin\x64;C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3\bin\x64;" + $env:PATH; Set-Location extraction-service; & "D:\book-assistant-lite\external\venv\Scripts\python.exe" -m uvicorn main:app --host 0.0.0.0 --port 8080 --log-level info'
    silent: false

  stop-marker:
    desc: Stop Marker service on port 8080
    cmds:
      - powershell -Command '$conn = Get-NetTCPConnection -LocalPort 8080 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force; echo "Marker stopped" } else { echo "Marker not running" }'

  restart-marker:
    desc: Restart Marker service
    cmds:
      - task: stop-marker
      - cmd /c "timeout /t 2 /nobreak >nul"
      - task: start-marker
    silent: false

  status-marker:
    desc: Check if Marker service is running
    cmds:
      - cmd /c "netstat -ano | findstr :8080 | findstr LISTENING || echo Marker not running"

  start-postgres:
    desc: Start PostgreSQL on port {{.PG_PORT}}
    cmds:
      - powershell -Command '$conn = Get-NetTCPConnection -LocalPort {{.PG_PORT}} -State Listen -ErrorAction SilentlyContinue; if ($conn) { echo "PostgreSQL already running on port {{.PG_PORT}}" } else { Start-Process -FilePath "{{.PG_DIR}}\bin\pg_ctl.exe" -ArgumentList "start -D {{.PG_DATA}}" -WindowStyle Hidden; echo "PostgreSQL started" }'
    silent: false

  stop-postgres:
    desc: Stop PostgreSQL on port {{.PG_PORT}}
    cmds:
      - powershell -Command '$conn = Get-NetTCPConnection -LocalPort {{.PG_PORT}} -State Listen -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force; echo "PostgreSQL stopped" } else { echo "PostgreSQL not running" }'

  restart-postgres:
    desc: Restart PostgreSQL
    cmds:
      - task: stop-postgres
      - cmd /c "timeout /t 2 /nobreak >nul"
      - task: start-postgres
    silent: false

  status-postgres:
    desc: Check if PostgreSQL is running
    cmds:
      - cmd /c "netstat -ano | findstr :{{.PG_PORT}} | findstr LISTENING || echo PostgreSQL not running"

  start-app:
    desc: Start Spring Boot app via local Maven
    cmds:
      - cmd /c ""D:/book-assistant-lite/external/mvn-dist/apache-maven-3.9.12/bin/mvn.cmd" spring-boot:3.5.0:run"
    silent: false

  stop-app:
    desc: Stop Spring Boot app on port 8083
    cmds:
      - powershell -Command '$conn = Get-NetTCPConnection -LocalPort 8083 -State Listen -ErrorAction SilentlyContinue; if ($conn) { Stop-Process -Id $conn.OwningProcess -Force; echo "App stopped" } else { echo "App not running" }'

  restart-app:
    desc: Restart Spring Boot app
    cmds:
      - task: stop-app
      - cmd /c "timeout /t 2 /nobreak >nul"
      - task: start-app
    silent: false

  status-app:
    desc: Check if Spring Boot app is running
    cmds:
      - cmd /c "netstat -ano | findstr :8083 | findstr LISTENING || echo App not running"

  compile-java:
    desc: Compile Java sources without Maven build
    cmds:
      - cmd /c "javac -d ../external/tmp -cp ../external/target/classes;C:\Users\Meena\.m2\repository\org\apache\pdfbox\pdfbox\3.0.4\pdfbox-3.0.4.jar" src\main\java\com\bookassistant\service\file\MarkerExtractionClient.java src\main\java\com\bookassistant\service\file\FileParserService.java

  check-java:
    desc: Check Java source syntax
    cmds:
      - task: compile-java

  test-extraction:
    desc: Test Marker service health endpoint
    cmds:
      - cmd /c "curl -s http://localhost:8080/health"

  test-marker-full:
    desc: Test Marker service with a sample PDF
    cmds:
      - cmd /c "curl -s -X POST http://localhost:8080/extract/pdf -F "file=@test-sample.pdf""

  open-project:
    desc: Start all project services (PostgreSQL + extraction + app)
    cmds:
      - task: start-postgres
      - task: start-marker
      - task: start-app
    silent: false

  close-project:
    desc: Stop all project services
    cmds:
      - task: stop-app
      - task: stop-marker
      - task: stop-postgres

  project-status:
    desc: Show status of all services
    cmds:
      - cmd /c "echo === PostgreSQL (port {{.PG_PORT}}) === && (netstat -ano | findstr :{{.PG_PORT}} | findstr LISTENING || echo Not running) && echo. && echo === Marker Service (port 8080) === && (netstat -ano | findstr :8080 | findstr LISTENING || echo Not running) && echo. && echo === Spring Boot App (port 8083) === && (netstat -ano | findstr :8083 | findstr LISTENING || echo Not running) && echo. && echo === Ollama (port 11434) === && (netstat -ano | findstr :11434 | findstr LISTENING || echo Not running)"

  logs-marker:
    desc: Tail Marker service logs
    cmds:
      - cmd /c "powershell -Command "Get-Content -Path extraction-service/logs/*.log -Tail 50 -Wait""

  logs-app:
    desc: Tail Spring Boot app logs
    cmds:
      - cmd /c "powershell -Command "Get-Content -Path ../external/logs/book-assistant.log -Tail 50 -Wait""
</file>

