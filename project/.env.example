# Book Assistant Lite - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
# Port for the application (default: 8083)
SERVER_PORT=8083

# Database Configuration (PostgreSQL)
# Create a fresh database named 'book_assistant' before running the app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# AI Configuration (Ollama local)
# Ollama must be running locally with the phi3.5:latest model pulled
AI_BASE_URL=http://localhost:11434/api/generate
AI_MODEL=phi3.5:latest
AI_API_KEY=
AI_TIMEOUT_SECONDS=86400